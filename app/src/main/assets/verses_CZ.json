[
  {"text": "Hospodin je můj pastýř, nebudu mít nedostatek.", "ref": "Žalm 23:1", "lang": "CZ"},
  {"text": "Všechno mohu v Kristu, který mi dává sílu.", "ref": "Filipským 4:13", "lang": "CZ"},
  {"text": "Neboť já znám úmysly, které s vámi mám, praví Hospodin.", "ref": "Jeremjáš 29:11", "lang": "CZ"},
  {"text": "Bůh je naše útočiště i síla, pomoc v úzkostech vždy osvědčená.", "ref": "Žalm 46:2", "lang": "CZ"},
  {"text": "Důvěřuj Hospodinu celým srdcem, na svoji rozumnost nespoléhej.", "ref": "Přísloví 3:5", "lang": "CZ"},
  {"text": "Neboť tak Bůh miloval svět, že dal svého jediného Syna.", "ref": "Jan 3:16", "lang": "CZ"},
  {"text": "A hle, já jsem s vámi po všecky dny až do skonání světa.", "ref": "Matouš 28:20", "lang": "CZ"},
  {"text": "Neboj se, vždyť já jsem s tebou, nerozhlížej se úzkostlivě, já jsem tvůj Bůh.", "ref": "Izajáš 41:10", "lang": "CZ"},
  {"text": "Hospodin je mé světlo a má spása, koho bych se bál?", "ref": "Žalm 27:1", "lang": "CZ"},
  {"text": "Žijeme z víry, ne z toho, co vidíme.", "ref": "2. Korintským 5:7", "lang": "CZ"},
  {"text": "Proste a bude vám dáno, hledejte a naleznete, tlučte a bude vám otevřeno.", "ref": "Matouš 7:7", "lang": "CZ"},
  {"text": "Vím, komu jsem uvěřil, a jsem si jist.", "ref": "2. Timoteovi 1:12", "lang": "CZ"},
  {"text": "Láska je trpělivá, laskavá.", "ref": "1. Korintským 13:4", "lang": "CZ"},
  {"text": "Radujte se v Pánu vždycky, znovu říkám: radujte se!", "ref": "Filipským 4:4", "lang": "CZ"},
  {"text": "U Hospodina je milosrdenství, u něho je hojné vykoupení.", "ref": "Žalm 130:7", "lang": "CZ"},
  {"text": "Já jsem ta cesta, pravda i život.", "ref": "Jan 14:6", "lang": "CZ"},
  {"text": "Milost našeho Pána Ježíše Krista buď s vámi.", "ref": "1. Tesalonickým 5:28", "lang": "CZ"},
  {"text": "Pokoj vám zanechávám, svůj pokoj vám dávám.", "ref": "Jan 14:27", "lang": "CZ"},
  {"text": "Světlem pro mé nohy je tvé slovo, osvěcuje moji stezku.", "ref": "Žalm 119:105", "lang": "CZ"},
  {"text": "Buďte rozhodní a zmužilí, nebojte se a nemějte z nich strach.", "ref": "Deuteronomium 31:6", "lang": "CZ"},
  {"text": "Nemilujme pouhým slovem, ale opravdovým činem.", "ref": "1. Janův 3:18", "lang": "CZ"},
  {"text": "Bůh je láska.", "ref": "1. Janův 4:8", "lang": "CZ"},
  {"text": "Hledejte především Boží království a jeho spravedlnost.", "ref": "Matouš 6:33", "lang": "CZ"},
  {"text": "Hospodin dává sílu svému lidu.", "ref": "Žalm 29:11", "lang": "CZ"},
  {"text": "V ztišení a důvěře bude vaše síla.", "ref": "Izajáš 30:15", "lang": "CZ"},
  {"text": "Stačí ti moje milost, protože síla se v slabosti dokonale projevuje.", "ref": "2. Korintským 12:9", "lang": "CZ"},
  {"text": "Vaše srdce ať se nechvěje úzkostí. Věříte v Boha, věřte i ve mne.", "ref": "Jan 14:1", "lang": "CZ"},
  {"text": "V něm žijeme, pohybujeme se a jsme.", "ref": "Skutky 17:28", "lang": "CZ"},
  {"text": "Pán je věrný; on vás utvrdí a ochrání od zlého.", "ref": "2. Tesalonickým 3:3", "lang": "CZ"},
  {"text": "Kdo zůstává v lásce, zůstává v Bohu a Bůh v něm.", "ref": "1. Janův 4:16", "lang": "CZ"},
  {"text": "Hospodin je milosrdný a milostivý, shovívavý a nejvýš milosrdný.", "ref": "Žalm 103:8", "lang": "CZ"},
  {"text": "Přibližte se k Bohu a přiblíží se k vám.", "ref": "Jakubův 4:8", "lang": "CZ"},
  {"text": "Srdce člověka rozvažuje o jeho cestě, ale jeho kroky řídí Hospodin.", "ref": "Přísloví 16:9", "lang": "CZ"},
  {"text": "Dobrý je Hospodin k těm, kdo v něho skládají naději.", "ref": "Pláč 3:25", "lang": "CZ"},
  {"text": "Já však v tebe doufám, Hospodine; pravím: 'Ty jsi můj Bůh.'", "ref": "Žalm 31:15", "lang": "CZ"},
  {"text": "Nebuďte smutní, neboť radost z Hospodina je vaše síla.", "ref": "Nehemjáš 8:10", "lang": "CZ"},
  {"text": "Všechno má svůj určený čas a veškeré dění pod nebem svůj čas.", "ref": "Kazatel 3:1", "lang": "CZ"},
  {"text": "Duch je ten, který dává život.", "ref": "Jan 6:63", "lang": "CZ"},
  {"text": "Blaze těm, kdo mají čisté srdce, neboť oni uzří Boha.", "ref": "Matouš 5:8", "lang": "CZ"},
  {"text": "Je-li Bůh s námi, kdo proti nám?", "ref": "Římanům 8:31", "lang": "CZ"},
  {"text": "Hospodin je blízko všem, kteří ho vzývají v opravdovosti.", "ref": "Žalm 145:18", "lang": "CZ"},
  {"text": "My jsme poznali lásku, kterou Bůh k nám má, a uvěřili jsme v ni.", "ref": "1. Janův 4:16", "lang": "CZ"},
  {"text": "Miluj svého bližního jako sám sebe.", "ref": "Marek 12:31", "lang": "CZ"},
  {"text": "Bůh stvořil člověka, aby byl jeho obrazem.", "ref": "Genesis 1:27", "lang": "CZ"},
  {"text": "V modlitbách neustávejte.", "ref": "1. Tesalonickým 5:17", "lang": "CZ"},
  {"text": "Kdo věří ve mne, i kdyby umřel, bude žít.", "ref": "Jan 11:25", "lang": "CZ"},
  {"text": "Já jsem dobrý pastýř. Dobrý pastýř položí svůj život za ovce.", "ref": "Jan 10:11", "lang": "CZ"},
  {"text": "Hospodin je má síla a můj štít.", "ref": "Žalm 28:7", "lang": "CZ"},
  {"text": "Chvalte Hospodina, neboť je dobrý.", "ref": "Žalm 136:1", "lang": "CZ"},
  {"text": "Neboj se, já ti pomáhám.", "ref": "Izajáš 41:13", "lang": "CZ"},
  {"text": "Slovo Pánovo zůstává na věky.", "ref": "1. Petrův 1:25", "lang": "CZ"},
  {"text": "Toto je den, který učinil Hospodin, jásejme a radujme se z něho.", "ref": "Žalm 118:24", "lang": "CZ"},
  {"text": "Bůh buď nám milostiv a žehnej nám.", "ref": "Žalm 67:2", "lang": "CZ"},
  {"text": "Dávejte a bude vám dáno.", "ref": "Lukáš 6:38", "lang": "CZ"},
  {"text": "Pojďte ke mně všichni, kdo se namáháte a jste obtíženi.", "ref": "Matouš 11:28", "lang": "CZ"},
  {"text": "Neboť já jsem s tebou, abych tě vysvobodil, je výrok Hospodinův.", "ref": "Jeremjáš 1:8", "lang": "CZ"},
  {"text": "Poznáte pravdu a pravda vás učiní svobodnými.", "ref": "Jan 8:32", "lang": "CZ"},
  {"text": "Víra je podstata věcí, v něž doufáme.", "ref": "Hebrejům 11:1", "lang": "CZ"},
  {"text": "Všechnu svou starost uvrhněte na něho, neboť mu na vás záleží.", "ref": "1. Petrův 5:7", "lang": "CZ"},
  {"text": "Žijte v pokoji, a Bůh lásky a pokoje bude s vámi.", "ref": "2. Korintským 13:11", "lang": "CZ"},
  {"text": "Hospodin Bůh je slunce i štít.", "ref": "Žalm 84:12", "lang": "CZ"},
  {"text": "Milujte své nepřátele.", "ref": "Matouš 5:44", "lang": "CZ"},
  {"text": "Svatý, svatý, svatý je Hospodin zástupů.", "ref": "Izajáš 6:3", "lang": "CZ"},
  {"text": "Ty jsi můj syn, já jsem tě dnes zplodil.", "ref": "Žalm 2:7", "lang": "CZ"},
  {"text": "Odpouštějte a bude vám odpuštěno.", "ref": "Lukáš 6:37", "lang": "CZ"},
  {"text": "Buďte milosrdní, jako je milosrdný váš Otec.", "ref": "Lukáš 6:36", "lang": "CZ"},
  {"text": "Já jsem Alfa i Omega, první i poslední.", "ref": "Zjevení 22:13", "lang": "CZ"},
  {"text": "Spravedlivý z víry bude živ.", "ref": "Římanům 1:17", "lang": "CZ"},
  {"text": "Velký je náš Pán a nesmírná je jeho moc.", "ref": "Žalm 147:5", "lang": "CZ"},
  {"text": "Kdo tluče, tomu bude otevřeno.", "ref": "Matouš 7:8", "lang": "CZ"},
  {"text": "Bůh je věrný: nedopustí, abyste byli podrobeni zkoušce, kterou nemůžete vydržet.", "ref": "1. Korintským 10:13", "lang": "CZ"},
  {"text": "Miluji tě, Hospodine, moje sílo.", "ref": "Žalm 18:2", "lang": "CZ"},
  {"text": "Ať ti Hospodin žehná a chrání tě.", "ref": "Numeri 6:24", "lang": "CZ"},
  {"text": "Víra bez skutků je mrtvá.", "ref": "Jakubův 2:26", "lang": "CZ"},
  {"text": "Pokoj vám!", "ref": "Jan 20:19", "lang": "CZ"},
  {"text": "Mluv, Hospodine, tvůj služebník slyší.", "ref": "1. Samuelova 3:9", "lang": "CZ"},
  {"text": "Bůh je má spása, doufám a netřesu se.", "ref": "Izajáš 12:2", "lang": "CZ"},
  {"text": "Blaze tichým, neboť oni dostanou zemi za dědictví.", "ref": "Matouš 5:5", "lang": "CZ"},
  {"text": "Moje ovce slyší můj hlas.", "ref": "Jan 10:27", "lang": "CZ"},
  {"text": "Moje časy jsou ve tvé ruce.", "ref": "Žalm 31:16", "lang": "CZ"},
  {"text": "Pán je můj pomocník, nebudu se bát.", "ref": "Hebrejům 13:6", "lang": "CZ"},
  {"text": "Hospodin kraluje! Zajásej, země.", "ref": "Žalm 97:1", "lang": "CZ"},
  {"text": "Člověk se dívá na to, co má před očima, Hospodin však hledí na srdce.", "ref": "1. Samuelova 16:7", "lang": "CZ"},
  {"text": "Budete mě hledat a naleznete mě, když mě budete hledat celým svým srdcem.", "ref": "Jeremjáš 29:13", "lang": "CZ"},
  {"text": "Miluj Hospodina, svého Boha, celým svým srdcem.", "ref": "Matouš 22:37", "lang": "CZ"},
  {"text": "A Slovo se stalo tělem a přebývalo mezi námi.", "ref": "Jan 1:14", "lang": "CZ"},
  {"text": "Kdo věří v Syna, má život věčný.", "ref": "Jan 3:36", "lang": "CZ"},
  {"text": "Nic nás nebude moci odloučit od lásky Boží.", "ref": "Římanům 8:39", "lang": "CZ"},
  {"text": "Bůh je skála mého srdce a můj podíl navěky.", "ref": "Žalm 73:26", "lang": "CZ"},
  {"text": "Vaše mírnost ať je známa všem lidem. Pán je blízko.", "ref": "Filipským 4:5", "lang": "CZ"},
  {"text": "Láska ať je bez přetvářky.", "ref": "Římanům 12:9", "lang": "CZ"},
  {"text": "Duch svatý vás naučí v tu hodinu, co je třeba říci.", "ref": "Lukáš 12:12", "lang": "CZ"},
  {"text": "V naději se radujte, v soužení buďte trpěliví, v modlitbách vytrvalí.", "ref": "Římanům 12:12", "lang": "CZ"},
  {"text": "Tvé milosrdenství je lepší než život.", "ref": "Žalm 63:4", "lang": "CZ"},
  {"text": "Svatí buďte v celém svém způsobu života.", "ref": "1. Petrův 1:15", "lang": "CZ"},
  {"text": "Hle, stojím u dveří a klepu. Kdo otevře, k tomu vejdu.", "ref": "Zjevení 3:20", "lang": "CZ"},
  {"text": "Vždyť Boží království není pokrm a nápoj, nýbrž spravedlnost, pokoj a radost v Duchu svatém.", "ref": "Římanům 14:17", "lang": "CZ"},
  {"text": "Kde jsou dva nebo tři shromážděni ve jménu mém, tam jsem já uprostřed nich.", "ref": "Matouš 18:20", "lang": "CZ"},
  {"text": "Váš nebeský Otec ví, co potřebujete.", "ref": "Matouš 6:32", "lang": "CZ"},
  {"text": "Duch Hospodinův je nade mnou.", "ref": "Lukáš 4:18", "lang": "CZ"},
  {"text": "U Boha je možné všechno.", "ref": "Matouš 19:26", "lang": "CZ"},
  {"text": "Hospodin je moje skála, můj hrad, můj vysvoboditel.", "ref": "Žalm 18:3", "lang": "CZ"},
  {"text": "Milost a pravda se stala skrze Ježíše Krista.", "ref": "Jan 1:17", "lang": "CZ"},
  {"text": "Břemena jedni druhých noste.", "ref": "Galatským 6:2", "lang": "CZ"},
  {"text": "Slovo Kristovo ať ve vás přebývá v celém svém bohatství.", "ref": "Koloským 3:16", "lang": "CZ"},
  {"text": "Hospodin je spravedlivý ve všech svých cestách.", "ref": "Žalm 145:17", "lang": "CZ"},
  {"text": "Mému srdci dáváš větší radost.", "ref": "Žalm 4:8", "lang": "CZ"},
  {"text": "Blaze milosrdným, neboť oni dojdou milosrdenství.", "ref": "Matouš 5:7", "lang": "CZ"},
  {"text": "Stvoř mi, Bože, čisté srdce.", "ref": "Žalm 51:12", "lang": "CZ"},
  {"text": "On uzdravuje ty, kdo jsou zkroušeni v srdci.", "ref": "Žalm 147:3", "lang": "CZ"},
  {"text": "Nauč mě plnit tvou vůli, vždyť jsi můj Bůh.", "ref": "Žalm 143:10", "lang": "CZ"},
  {"text": "Ty jsi, Hospodine, štít kolem mne, jsi moje sláva.", "ref": "Žalm 3:4", "lang": "CZ"},
  {"text": "Slyš mě, Hospodine, když volám svým hlasem.", "ref": "Žalm 27:7", "lang": "CZ"},
  {"text": "Ty jsi můj Bůh, tobě vzdávám chválu.", "ref": "Žalm 118:28", "lang": "CZ"},
  {"text": "Ať Pán vede vaše srdce k Boží lásce.", "ref": "2. Tesalonickým 3:5", "lang": "CZ"},
  {"text": "Protože jsi v mých očích tak drahý, vzácný, protože tě miluji.", "ref": "Izajáš 43:4", "lang": "CZ"},
  {"text": "Mně se však Hospodin stal hradem, můj Bůh skálou mého útočiště.", "ref": "Žalm 94:22", "lang": "CZ"},
  {"text": "O nic nemějte starost.", "ref": "Filipským 4:6", "lang": "CZ"},
  {"text": "Hospodin je náš Král, on nás spasí.", "ref": "Izajáš 33:22", "lang": "CZ"},
  {"text": "Nasyť nás svým milosrdenstvím hned ráno.", "ref": "Žalm 90:14", "lang": "CZ"},
  {"text": "Blaze těm, kdo pláčou, neboť oni budou potěšeni.", "ref": "Matouš 5:4", "lang": "CZ"},
  {"text": "Kdo mě následuje, nebude chodit ve tmě.", "ref": "Jan 8:12", "lang": "CZ"},
  {"text": "Hospodin je má skála a můj hrad.", "ref": "Žalm 144:2", "lang": "CZ"},
  {"text": "Bůh je naše útočiště.", "ref": "Žalm 62:9", "lang": "CZ"},
  {"text": "Jdi v pokoji.", "ref": "Lukáš 7:50", "lang": "CZ"},
  {"text": "Radost z Hospodina je vaše síla.", "ref": "Nehemjáš 8:10", "lang": "CZ"},
  {"text": "Hospodin je Bůh pravý.", "ref": "Jeremjáš 10:10", "lang": "CZ"},
  {"text": "Hospodin je dobrý.", "ref": "Žalm 100:5", "lang": "CZ"},
  {"text": "Milujte pravdu a pokoj.", "ref": "Zacharjáš 8:19", "lang": "CZ"},
  {"text": "Neustále se modlete.", "ref": "1. Tesalonickým 5:17", "lang": "CZ"},
  {"text": "Důvěřuj Bohu.", "ref": "Přísloví 3:5", "lang": "CZ"},
  {"text": "Bůh je věrný.", "ref": "1. Korintským 1:9", "lang": "CZ"},
  {"text": "Bůh je tvůj pastýř.", "ref": "Žalm 23:1", "lang": "CZ"},
  {"text": "Duch svatý je tvůj těšitel.", "ref": "Jan 14:26", "lang": "CZ"},
  {"text": "Ježíš je Pán.", "ref": "Římanům 10:9", "lang": "CZ"},
  {"text": "Miluj Boha.", "ref": "Deuteronomium 6:5", "lang": "CZ"},
  {"text": "Poznej Boha.", "ref": "1. Janův 5:20", "lang": "CZ"},
  {"text": "Bůh nás chrání.", "ref": "2. Tesalonickým 3:3", "lang": "CZ"},
  {"text": "Máme naději v Kristu.", "ref": "1. Korintským 15:19", "lang": "CZ"},
  {"text": "Pán je světlo.", "ref": "Jan 1:5", "lang": "CZ"},
  {"text": "Láska vítězí.", "ref": "Římanům 12:21", "lang": "CZ"},
  {"text": "Bůh je s námi.", "ref": "Matouš 1:23", "lang": "CZ"},
  {"text": "Věř v Krista.", "ref": "Skutky 16:31", "lang": "CZ"},
  {"text": "Hledej pokoj.", "ref": "Žalm 34:15", "lang": "CZ"},
  {"text": "Pán ti pomůže.", "ref": "Izajáš 41:10", "lang": "CZ"},
  {"text": "Vše má svůj čas.", "ref": "Kazatel 3:1", "lang": "CZ"},
  {"text": "Bůh miluje svět.", "ref": "Jan 3:16", "lang": "CZ"},
  {"text": "Duch nás vede.", "ref": "Římanům 8:14", "lang": "CZ"},
  {"text": "Kristus vstal z mrtvých.", "ref": "Matouš 28:6", "lang": "CZ"},
  {"text": "Buďte trpěliví.", "ref": "Jakubův 5:7", "lang": "CZ"},
  {"text": "Modlitba má moc.", "ref": "Jakubův 5:16", "lang": "CZ"},
  {"text": "Bůh je útočiště.", "ref": "Žalm 46:2", "lang": "CZ"},
  {"text": "Pán je můj štít.", "ref": "Žalm 28:7", "lang": "CZ"},
  {"text": "Láska je největší.", "ref": "1. Korintským 13:13", "lang": "CZ"},
  {"text": "Žijte ve světle.", "ref": "Efezským 5:8", "lang": "CZ"},
  {"text": "Bůh je věrný v slibech.", "ref": "Hebrejům 10:23", "lang": "CZ"},
  {"text": "Buď svatý.", "ref": "1. Petrův 1:16", "lang": "CZ"},
  {"text": "Pán tě povolal.", "ref": "Izajáš 43:1", "lang": "CZ"},
  {"text": "Kristus je náš pokoj.", "ref": "Efezským 2:14", "lang": "CZ"},
  {"text": "Chléb náš vezdejší dej nám dnes.", "ref": "Matouš 6:11", "lang": "CZ"},
  {"text": "Boží slovo je pravda.", "ref": "Jan 17:17", "lang": "CZ"},
  {"text": "Důvěřuj Hospodinu.", "ref": "Žalm 37:3", "lang": "CZ"},
  {"text": "Bůh je náš Otec.", "ref": "Matouš 6:9", "lang": "CZ"},
  {"text": "Vše stvořil Bůh.", "ref": "Genesis 1:1", "lang": "CZ"},
  {"text": "Pán je dobrotivý.", "ref": "Žalm 145:9", "lang": "CZ"},
  {"text": "Bůh slyší tvůj hlas.", "ref": "Žalm 116:1", "lang": "CZ"},
  {"text": "Máme věčný život.", "ref": "1. Janův 5:13", "lang": "CZ"},
  {"text": "Pán tě posílí.", "ref": "2. Tesalonickým 3:3", "lang": "CZ"},
  {"text": "Hledejte pokoj.", "ref": "1. Petrův 3:11", "lang": "CZ"},
  {"text": "Bůh je mocný.", "ref": "Lukáš 1:37", "lang": "CZ"},
  {"text": "Ježíš miluje děti.", "ref": "Matouš 19:14", "lang": "CZ"},
  {"text": "Buď silný v Pánu.", "ref": "Efezským 6:10", "lang": "CZ"},
  {"text": "Láska nikdy nezaniká.", "ref": "1. Korintským 13:8", "lang": "CZ"},
  {"text": "Pán je tvá spása.", "ref": "Exodus 15:2", "lang": "CZ"},
  {"text": "Bůh je můj král.", "ref": "Žalm 44:5", "lang": "CZ"},
  {"text": "Milujte pravdu a pokoj.", "ref": "Zacharjáš 8:19", "lang": "CZ"},
  {"text": "Odpouštějte si.", "ref": "Efezským 4:32", "lang": "CZ"},
  {"text": "Bůh je světlo života.", "ref": "Jan 8:12", "lang": "CZ"},
  {"text": "Pán je tvá pomoc.", "ref": "Žalm 121:2", "lang": "CZ"},
  {"text": "Milost buď s tebou.", "ref": "2. Korintským 13:13", "lang": "CZ"},
  {"text": "Důvěra přináší pokoj.", "ref": "Izajáš 26:3", "lang": "CZ"},
  {"text": "Bůh ti žehná.", "ref": "Genesis 12:2", "lang": "CZ"},
  {"text": "Kristus je hlava.", "ref": "Koloským 1:18", "lang": "CZ"},
