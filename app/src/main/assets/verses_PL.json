  {"text": "Pan prowadzi nad wody spokojne.", "ref": "Psalm 23:2", "lang": "PL"},
  {"text": "Wola Boża jest dobra.", "ref": "Rzymian 12:2", "lang": "PL"},
  {"text": "Chrystus nas odkupił.", "ref": "Galatów 3:13", "lang": "PL"},
  {"text": "Pan twoją mocą.", "ref": "Habakuka 3:19", "lang": "PL"},
  {"text": "Bóg powołał nas do pokoju.", "ref": "1 Koryntian 7:15", "lang": "PL"},
  {"text": "Miłujmy się wzajemnie.", "ref": "1 Jana 4:7", "lang": "PL"},
  {"text": "Pan twoją nadzieją.", "ref": "Psalm 71:5", "lang": "PL"},
  {"text": "Łaska Boża jest wielka.", "ref": "Efezjan 2:4", "lang": "PL"},
  {"text": "Chrystus żyje we mnie.", "ref": "Galatów 2:20", "lang": "PL"},
  {"text": "Pan daje ci mądrość.", "ref": "Jakuba 1:5", "lang": "PL"},
  {"text": "Bóg naszym pasterzem.", "ref": "Izajasza 40:11", "lang": "PL"},
  {"text": "Szukajcie dobra.", "ref": "Amosa 5:14", "lang": "PL"},
  {"text": "Pan twoim Odkupicielem.", "ref": "Izajasza 44:6", "lang": "PL"},
  {"text": "W Bogu źródło życia.", "ref": "Psalm 36:10", "lang": "PL"},
  {"text": "Miłość wszystko znosi.", "ref": "1 Koryntian 13:7", "lang": "PL"},
