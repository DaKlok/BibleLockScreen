  {"text": "Chrystus naszym życiem.", "ref": "Kolosan 3:4", "lang": "PL"},
  {"text": "Pan uczy nas kochać.", "ref": "1 Tesaloniczan 4:9", "lang": "PL"},
  {"text": "Prawda Boża wyzwala.", "ref": "Jana 8:32", "lang": "PL"},
  {"text": "Szukajcie Pana.", "ref": "Sofoniasza 2:3", "lang": "PL"},
