[
  {"text": "Pan jest moim pasterzem, nie brak mi niczego.", "ref": "Psalm 23:1", "lang": "PL"},
  {"text": "Wszystko mogę w Tym, który mnie umacnia.", "ref": "Filipian 4:13", "lang": "PL"},
  {"text": "Jestem bowiem świadomy zamiarów, jakie mam o was – wyrocznia Pana.", "ref": "Jeremiasza 29:11", "lang": "PL"},
  {"text": "Bóg jest dla nas ucieczką i mocą: najpewniejszą pomocą w trudnościach.", "ref": "Psalm 46:2", "lang": "PL"},
  {"text": "Z całego serca Bogu zaufaj, nie polegaj na swoim rozsądku.", "ref": "Przysłów 3:5", "lang": "PL"},
  {"text": "Tak bowiem Bóg umiłował świat, że Syna swego Jednorodzonego dał.", "ref": "Jana 3:16", "lang": "PL"},
  {"text": "A oto Ja jestem z wami przez wszystkie dni, aż do skończenia świata.", "ref": "Mateusza 28:20", "lang": "PL"},
  {"text": "Nie lękaj się, bo Ja jestem z tobą; nie trwóż się, bo Ja jestem twoim Bogiem.", "ref": "Izajasza 41:10", "lang": "PL"},
  {"text": "Pan światłem i zbawieniem moim: kogo mam się lękać?", "ref": "Psalm 27:1", "lang": "PL"},
  {"text": "W wierze bowiem kroczymy, a nie w oglądaniu.", "ref": "2 Koryntian 5:7", "lang": "PL"},
  {"text": "Proście, a będzie wam dane; szukajcie, a znajdziecie; kołaczcie, a otworzą wam.", "ref": "Mateusza 7:7", "lang": "PL"},
  {"text": "Wiem, komu zawierzyłem, i jestem pewny.", "ref": "2 Tymoteusza 1:12", "lang": "PL"},
  {"text": "Miłość cierpliwa jest, łaskawa jest.", "ref": "1 Koryntian 13:4", "lang": "PL"},
  {"text": "Radujcie się zawsze w Panu; jeszcze raz powtarzam: radujcie się!", "ref": "Filipian 4:4", "lang": "PL"},
  {"text": "U Pana jest bowiem łaska, u Niego obfite odkupienie.", "ref": "Psalm 130:7", "lang": "PL"},
  {"text": "Ja jestem drogą i prawdą, i życiem.", "ref": "Jana 14:6", "lang": "PL"},
  {"text": "Łaska Pana naszego Jezusa Chrystusa niech będzie z wami!", "ref": "1 Tesaloniczan 5:28", "lang": "PL"},
  {"text": "Pokój zostawiam wam, pokój mój daję wam.", "ref": "Jana 14:27", "lang": "PL"},
  {"text": "Twoje słowo jest lampą dla moich stóp i światłem na mojej ścieżce.", "ref": "Psalm 119:105", "lang": "PL"},
  {"text": "Bądźcie mężni i mocni, nie lękajcie się i nie bójcie się ich.", "ref": "Powtórzonego Prawa 31:6", "lang": "PL"},
  {"text": "Nie miłujmy słowem i językiem, ale czynem i prawdą!", "ref": "1 Jana 3:18", "lang": "PL"},
  {"text": "Bóg jest miłością.", "ref": "1 Jana 4:8", "lang": "PL"},
  {"text": "Starajcie się naprzód o królestwo Boga i o Jego sprawiedliwość.", "ref": "Mateusza 6:33", "lang": "PL"},
  {"text": "Pan udzieli mocy swojemu ludowi.", "ref": "Psalm 29:11", "lang": "PL"},
  {"text": "W ciszy i ufności leży wasza siła.", "ref": "Izajasza 30:15", "lang": "PL"},
  {"text": "Wystarczy ci mojej łaski. Moc bowiem w słabości się doskonali.", "ref": "2 Koryntian 12:9", "lang": "PL"},
  {"text": "Niech się nie trwoży serce wasze. Wierzycie w Boga? I we Mnie wierzcie!", "ref": "Jana 14:1", "lang": "PL"},
  {"text": "W Nim bowiem żyjemy, poruszamy się i jesteśmy.", "ref": "Dzieje Apostolskie 17:28", "lang": "PL"},
  {"text": "Wierny jest Pan, który was umocni i ustrzeże od złego.", "ref": "2 Tesaloniczan 3:3", "lang": "PL"},
  {"text": "Kto trwa w miłości, trwa w Bogu, a Bóg trwa w nim.", "ref": "1 Jana 4:16", "lang": "PL"},
  {"text": "Miłosierny jest Pan i łaskawy, nieskory do gniewu i bardzo cierpliwy.", "ref": "Psalm 103:8", "lang": "PL"},
  {"text": "Przystąpcie bliżej do Boga, to i On zbliży się do was.", "ref": "Jakuba 4:8", "lang": "PL"},
  {"text": "Serce człowieka obmyśla drogi, lecz Pan kieruje krokami.", "ref": "Przysłów 16:9", "lang": "PL"},
  {"text": "Dobry jest Pan dla tego, kto Go wyczekuje.", "ref": "Lamentacje 3:25", "lang": "PL"},
  {"text": "Ja zaś pokładam ufność w Tobie, Panie, mówię: Ty jesteś moim Bogiem.", "ref": "Psalm 31:15", "lang": "PL"},
  {"text": "Nie bądźcie przygnębieni, gdyż radość w Panu jest waszą ostoją.", "ref": "Nehemiasza 8:10", "lang": "PL"},
  {"text": "Wszystko ma swój czas i jest wyznaczona godzina na każdą sprawę pod niebem.", "ref": "Koheleta 3:1", "lang": "PL"},
  {"text": "Duch daje życie.", "ref": "Jana 6:63", "lang": "PL"},
  {"text": "Błogosławieni czystego serca, albowiem oni Boga oglądać będą.", "ref": "Mateusza 5:8", "lang": "PL"},
  {"text": "Jeżeli Bóg z nami, któż przeciwko nam?", "ref": "Rzymian 8:31", "lang": "PL"},
  {"text": "Pan jest blisko wszystkich, którzy Go wzywają, wszystkich wzywających Go szczerze.", "ref": "Psalm 145:18", "lang": "PL"},
  {"text": "Myśmy poznali i uwierzyli miłości, jaką Bóg ma ku nam.", "ref": "1 Jana 4:16", "lang": "PL"},
  {"text": "Będziesz miłował swego bliźniego jak siebie samego.", "ref": "Marka 12:31", "lang": "PL"},
  {"text": "Stworzył więc Bóg człowieka na swój obraz.", "ref": "Rodzaju 1:27", "lang": "PL"},
  {"text": "Nieustannie się módlcie.", "ref": "1 Tesaloniczan 5:17", "lang": "PL"},
  {"text": "Kto wierzy we Mnie, choćby i umarł, żyć będzie.", "ref": "Jana 11:25", "lang": "PL"},
  {"text": "Ja jestem dobrym pasterzem. Dobry pasterz daje życie swoje za owce.", "ref": "Jana 10:11", "lang": "PL"},
  {"text": "Pan moją mocą i tarczą.", "ref": "Psalm 28:7", "lang": "PL"},
  {"text": "Wysławiajcie Pana, bo jest dobry.", "ref": "Psalm 136:1", "lang": "PL"},
  {"text": "Nie lękaj się, przychodzę ci z pomocą!", "ref": "Izajasza 41:13", "lang": "PL"},
  {"text": "Słowo Pańskie trwa na wieki.", "ref": "1 Piotra 1:25", "lang": "PL"},
  {"text": "Oto dzień, który Pan uczynił: radujmy się w nim i weselmy!", "ref": "Psalm 118:24", "lang": "PL"},
  {"text": "Niech Bóg się zmiłuje nad nami i nam błogosławi.", "ref": "Psalm 67:2", "lang": "PL"},
  {"text": "Dawajcie, a będzie wam dane.", "ref": "Łukasza 6:38", "lang": "PL"},
  {"text": "Przyjdźcie do Mnie wszyscy, którzy utrudzeni i obciążeni jesteście.", "ref": "Mateusza 11:28", "lang": "PL"},
  {"text": "Gdyż Ja jestem z tobą, by cię chronić – wyrocznia Pana.", "ref": "Jeremiasza 1:8", "lang": "PL"},
  {"text": "Poznacie prawdę, a prawda was wyzwoli.", "ref": "Jana 8:32", "lang": "PL"},
  {"text": "Wiara jest poręką tych dóbr, których się spodziewamy.", "ref": "Hebrajczyków 11:1", "lang": "PL"},
  {"text": "Wszystkie troski wasze przerzućcie na Niego, gdyż Jemu zależy na was.", "ref": "1 Piotra 5:7", "lang": "PL"},
  {"text": "Zachowujcie pokój, a Bóg miłości i pokoju będzie z wami.", "ref": "2 Koryntian 13:11", "lang": "PL"},
  {"text": "Bo słońcem i tarczą jest Pan, Bóg.", "ref": "Psalm 84:12", "lang": "PL"},
  {"text": "Miłujcie waszych nieprzyjaciół.", "ref": "Mateusza 5:44", "lang": "PL"},
  {"text": "Święty, Święty, Święty jest Pan Zastępów.", "ref": "Izajasza 6:3", "lang": "PL"},
  {"text": "Tyś Synem moim, Ja Ciebie dziś zrodziłem.", "ref": "Psalm 2:7", "lang": "PL"},
  {"text": "Odpuszczajcie, a będzie wam odpuszczone.", "ref": "Łukasza 6:37", "lang": "PL"},
  {"text": "Bądźcie miłosierni, jak Ojciec wasz jest miłosierny.", "ref": "Łukasza 6:36", "lang": "PL"},
  {"text": "Ja jestem Alfa i Omega, Pierwszy i Ostatni.", "ref": "Apokalipsa 22:13", "lang": "PL"},
  {"text": "Sprawiedliwy z wiary żyć będzie.", "ref": "Rzymian 1:17", "lang": "PL"},
  {"text": "Wielki jest Pan nasz i potężny w swej mocy.", "ref": "Psalm 147:5", "lang": "PL"},
  {"text": "Temu, kto kołacze, otworzą.", "ref": "Mateusza 7:8", "lang": "PL"},
  {"text": "Wierny jest Bóg i nie pozwoli was kusić ponad to, co potraficie znieść.", "ref": "1 Koryntian 10:13", "lang": "PL"},
  {"text": "Miłuję Cię, Panie, Mocy moja!", "ref": "Psalm 18:2", "lang": "PL"},
  {"text": "Niech cię Pan błogosławi i strzeże.", "ref": "Liczb 6:24", "lang": "PL"},
  {"text": "Wiara bez uczynków jest martwa.", "ref": "Jakuba 2:26", "lang": "PL"},
  {"text": "Pokój wam!", "ref": "Jana 20:19", "lang": "PL"},
  {"text": "Mów, Panie, bo sługa Twój słucha.", "ref": "1 Samuela 3:9", "lang": "PL"},
  {"text": "Oto Bóg jest moim zbawieniem, ufam i bać się nie będę.", "ref": "Izajasza 12:2", "lang": "PL"},
  {"text": "Błogosławieni cisi, albowiem oni na własność posiądą ziemię.", "ref": "Mateusza 5:5", "lang": "PL"},
  {"text": "Moje owce słuchają mego głosu.", "ref": "Jana 10:27", "lang": "PL"},
  {"text": "W Twoim ręku są moje losy.", "ref": "Psalm 31:16", "lang": "PL"},
  {"text": "Pan jest moim wspomożycielem, nie będę się lękał.", "ref": "Hebrajczyków 13:6", "lang": "PL"},
  {"text": "Pan króluje, niech raduje się ziemia.", "ref": "Psalm 97:1", "lang": "PL"},
  {"text": "Człowiek patrzy na to, co widoczne dla oczu, Pan zaś patrzy na serce.", "ref": "1 Samuela 16:7", "lang": "PL"},
  {"text": "Będziecie Mnie szukać i znajdziecie Mnie, gdy Mnie będziecie szukać całym sercem.", "ref": "Jeremiasza 29:13", "lang": "PL"},
  {"text": "Będziesz miłował Pana Boga swego całym swoim sercem.", "ref": "Mateusza 22:37", "lang": "PL"},
  {"text": "A Słowo stało się ciałem i zamieszkało wśród nas.", "ref": "Jana 1:14", "lang": "PL"},
  {"text": "Kto wierzy w Syna, ma życie wieczne.", "ref": "Jana 3:36", "lang": "PL"},
  {"text": "Nic nie zdoła nas odłączyć od miłości Boga.", "ref": "Rzymian 8:39", "lang": "PL"},
  {"text": "Bóg jest opoką mego serca i moją cząstką na wieki.", "ref": "Psalm 73:26", "lang": "PL"},
  {"text": "Niech wasza łagodność będzie znana wszystkim ludziom. Pan jest blisko!", "ref": "Filipian 4:5", "lang": "PL"},
  {"text": "Miłość niech będzie bez obłudy.", "ref": "Rzymian 12:9", "lang": "PL"},
  {"text": "Duch Święty nauczy was w tej właśnie godzinie, co należy powiedzieć.", "ref": "Łukasza 12:12", "lang": "PL"},
  {"text": "Weselcie się nadzieją, w ucisku bądźcie cierpliwi, w modlitwie – wytrwali.", "ref": "Rzymian 12:12", "lang": "PL"},
  {"text": "Lepsza jest Twoja łaska od życia.", "ref": "Psalm 63:4", "lang": "PL"},
  {"text": "Bądźcie świętymi we wszystkim waszym postępowaniu.", "ref": "1 Piotra 1:15", "lang": "PL"},
  {"text": "Oto stoję u drzwi i kołaczę.", "ref": "Apokalipsa 3:20", "lang": "PL"},
  {"text": "Królestwo Boże to sprawiedliwość, pokój i radość w Duchu Świętym.", "ref": "Rzymian 14:17", "lang": "PL"},
  {"text": "Gdzie są dwaj albo trzej zebrani w imię moje, tam jestem pośród nich.", "ref": "Mateusza 18:20", "lang": "PL"},
  {"text": "Ojciec wasz niebieski wie, że tego wszystkiego potrzebujecie.", "ref": "Mateusza 6:32", "lang": "PL"},
  {"text": "Duch Pański spoczywa na Mnie.", "ref": "Łukasza 4:18", "lang": "PL"},
  {"text": "U Boga wszystko jest możliwe.", "ref": "Mateusza 19:26", "lang": "PL"},
  {"text": "Panie, opoko moja, twierdzo moja i wybawco.", "ref": "Psalm 18:3", "lang": "PL"},
  {"text": "Łaska i prawda przyszły przez Jezusa Chrystusa.", "ref": "Jana 1:17", "lang": "PL"},
  {"text": "Jeden drugiego brzemiona noście.", "ref": "Galatów 6:2", "lang": "PL"},
  {"text": "Słowo Chrystusa niech w was mieszka z całym swym bogactwem.", "ref": "Kolosan 3:16", "lang": "PL"},
  {"text": "Pan jest sprawiedliwy na wszystkich swych drogach.", "ref": "Psalm 145:17", "lang": "PL"},
  {"text": "Wlałeś w moje serce radość większą niż ta, którą oni mają.", "ref": "Psalm 4:8", "lang": "PL"},
  {"text": "Błogosławieni miłosierni, albowiem oni miłosierdzia dostąpią.", "ref": "Mateusza 5:7", "lang": "PL"},
  {"text": "Stwórz, o Boże, we mnie serce czyste.", "ref": "Psalm 51:12", "lang": "PL"},
  {"text": "On leczy złamanych na duchu.", "ref": "Psalm 147:3", "lang": "PL"},
  {"text": "Naucz mnie czynić Twoją wolę, bo Ty jesteś moim Bogiem.", "ref": "Psalm 143:10", "lang": "PL"},
  {"text": "Ale Ty, Panie, jesteś dla mnie tarczą, Tyś moją chwałą.", "ref": "Psalm 3:4", "lang": "PL"},
  {"text": "Usłysz, o Panie, mój głos, gdy wołam.", "ref": "Psalm 27:7", "lang": "PL"},
  {"text": "Ty jesteś moim Bogiem, Tobie dziękuję.", "ref": "Psalm 118:28", "lang": "PL"},
  {"text": "Niech Pan skieruje serca wasze ku miłości Bożej.", "ref": "2 Tesaloniczan 3:5", "lang": "PL"},
  {"text": "Ponieważ drogi jesteś w moich oczach, czczony i Ja cię miłuję.", "ref": "Izajasza 43:4", "lang": "PL"},
  {"text": "Pan stał się moją obroną, a Bóg mój opoką mojego schronienia.", "ref": "Psalm 94:22", "lang": "PL"},
  {"text": "O nic się już nie martwcie.", "ref": "Filipian 4:6", "lang": "PL"},
  {"text": "Pan jest naszym Królem; On nas zbawi!", "ref": "Izajasza 33:22", "lang": "PL"},
  {"text": "Nasyć nas rano swoją łaską.", "ref": "Psalm 90:14", "lang": "PL"},
  {"text": "Błogosławieni, którzy się smucą, albowiem oni będą pocieszeni.", "ref": "Mateusza 5:4", "lang": "PL"},
  {"text": "Kto idzie za Mną, nie będzie chodził w ciemności.", "ref": "Jana 8:12", "lang": "PL"},
  {"text": "Pan moją opoką i moją twierdzą.", "ref": "Psalm 144:2", "lang": "PL"},
  {"text": "Bóg jest naszą ucieczką.", "ref": "Psalm 62:9", "lang": "PL"},
  {"text": "Idź w pokoju.", "ref": "Łukasza 7:50", "lang": "PL"},
  {"text": "Radość w Panu jest waszą ostoją.", "ref": "Nehemiasza 8:10", "lang": "PL"},
  {"text": "Pan jest prawdziwym Bogiem.", "ref": "Jeremiasza 10:10", "lang": "PL"},
  {"text": "Pan jest dobry.", "ref": "Psalm 100:5", "lang": "PL"},
  {"text": "Miłujcie prawdę i pokój.", "ref": "Zachariasza 8:19", "lang": "PL"},
  {"text": "Nieustannie się módlcie.", "ref": "1 Tesaloniczan 5:17", "lang": "PL"},
  {"text": "Zaufaj Bogu.", "ref": "Przysłów 3:5", "lang": "PL"},
  {"text": "Bóg jest wierny.", "ref": "1 Koryntian 1:9", "lang": "PL"},
  {"text": "Pan jest twoim pasterzem.", "ref": "Psalm 23:1", "lang": "PL"},
  {"text": "Duch Święty jest twoim Pocieszycielem.", "ref": "Jana 14:26", "lang": "PL"},
  {"text": "Jezus jest Panem.", "ref": "Rzymian 10:9", "lang": "PL"},
  {"text": "Miłuj Boga.", "ref": "Powtórzonego Prawa 6:5", "lang": "PL"},
  {"text": "Poznaj Boga.", "ref": "1 Jana 5:20", "lang": "PL"},
  {"text": "Bóg nas chroni.", "ref": "2 Tesaloniczan 3:3", "lang": "PL"},
  {"text": "Mamy nadzieję w Chrystusie.", "ref": "1 Koryntian 15:19", "lang": "PL"},
  {"text": "Pan jest światłością.", "ref": "Jana 1:5", "lang": "PL"},
  {"text": "Miłość wszystko zwycięża.", "ref": "Rzymian 12:21", "lang": "PL"},
  {"text": "Bóg z nami.", "ref": "Mateusza 1:23", "lang": "PL"},
  {"text": "Wierz w Chrystusa.", "ref": "Dzieje Apostolskie 16:31", "lang": "PL"},
  {"text": "Szukaj pokoju.", "ref": "Psalm 34:15", "lang": "PL"},
  {"text": "Pan ci pomoże.", "ref": "Izajasza 41:10", "lang": "PL"},
  {"text": "Wszystko ma swój czas.", "ref": "Koheleta 3:1", "lang": "PL"},
  {"text": "Bóg kocha świat.", "ref": "Jana 3:16", "lang": "PL"},
  {"text": "Duch nas prowadzi.", "ref": "Rzymian 8:14", "lang": "PL"},
  {"text": "Chrystus zmartwychwstał.", "ref": "Mateusza 28:6", "lang": "PL"},
  {"text": "Bądźcie cierpliwi.", "ref": "Jakuba 5:7", "lang": "PL"},
  {"text": "Modlitwa ma moc.", "ref": "Jakuba 5:16", "lang": "PL"},
  {"text": "Bóg jest schronieniem.", "ref": "Psalm 46:2", "lang": "PL"},
  {"text": "Pan moją tarczą.", "ref": "Psalm 28:7", "lang": "PL"},
  {"text": "Miłość jest największa.", "ref": "1 Koryntian 13:13", "lang": "PL"},
  {"text": "Chodźcie w światłości.", "ref": "Efezjan 5:8", "lang": "PL"},
  {"text": "Bóg jest wierny w swych obietnicach.", "ref": "Hebrajczyków 10:23", "lang": "PL"},
  {"text": "Bądźcie świętymi.", "ref": "1 Piotra 1:16", "lang": "PL"},
  {"text": "Pan cię powołał.", "ref": "Izajasza 43:1", "lang": "PL"},
  {"text": "Chrystus naszym pokojem.", "ref": "Efezjan 2:14", "lang": "PL"},
  {"text": "Chleba naszego powszedniego daj nam dzisiaj.", "ref": "Mateusza 6:11", "lang": "PL"},
  {"text": "Słowo Twoje jest prawdą.", "ref": "Jana 17:17", "lang": "PL"},
  {"text": "Zaufaj Panu.", "ref": "Psalm 37:3", "lang": "PL"},
  {"text": "Bóg naszym Ojcem.", "ref": "Mateusza 6:9", "lang": "PL"},
  {"text": "Bóg stworzył wszystko.", "ref": "Rodzaju 1:1", "lang": "PL"},
  {"text": "Pan jest łaskawy.", "ref": "Psalm 145:9", "lang": "PL"},
  {"text": "Bóg słyszy twój głos.", "ref": "Psalm 116:1", "lang": "PL"},
  {"text": "Mamy życie wieczne.", "ref": "1 Jana 5:13", "lang": "PL"},
  {"text": "Pan cię umocni.", "ref": "2 Tesaloniczan 3:3", "lang": "PL"},
  {"text": "Szukaj zgody.", "ref": "1 Piotra 3:11", "lang": "PL"},
  {"text": "Bóg jest potężny.", "ref": "Łukasza 1:37", "lang": "PL"},
  {"text": "Jezus kocha dzieci.", "ref": "Mateusza 19:14", "lang": "PL"},
  {"text": "Bądźcie mocni w Panu.", "ref": "Efezjan 6:10", "lang": "PL"},
  {"text": "Miłość nigdy nie ustaje.", "ref": "1 Koryntian 13:8", "lang": "PL"},
  {"text": "Pan twoim zbawieniem.", "ref": "Wyjścia 15:2", "lang": "PL"},
  {"text": "Bóg moim Królem.", "ref": "Psalm 44:5", "lang": "PL"},
  {"text": "Miłujcie prawdę.", "ref": "Zachariasza 8:19", "lang": "PL"},
  {"text": "Wybaczajcie sobie nawzajem.", "ref": "Efezjan 4:32", "lang": "PL"},
  {"text": "Bóg światłem życia.", "ref": "Jana 8:12", "lang": "PL"},
  {"text": "Pan twoją pomocą.", "ref": "Psalm 121:2", "lang": "PL"},
  {"text": "Łaska z wami.", "ref": "2 Koryntian 13:13", "lang": "PL"},
  {"text": "Zaufanie przynosi pokój.", "ref": "Izajasza 26:3", "lang": "PL"},
  {"text": "Bóg cię błogosławi.", "ref": "Rodzaju 12:2", "lang": "PL"},
  {"text": "Chrystus jest Głową.", "ref": "Kolosan 1:18", "lang": "PL"},
  {"text": "Królestwo Boże jest blisko.", "ref": "Marka 1:15", "lang": "PL"},
  {"text": "Pan twoim stróżem.", "ref": "Psalm 121:5", "lang": "PL"},
  {"text": "Przez wiarę góry przenosimy.", "ref": "Mateusza 17:20", "lang": "PL"},
  {"text": "Bóg daje ci radość.", "ref": "Psalm 16:11", "lang": "PL"},
  {"text": "Jezus ten sam wczoraj i dziś.", "ref": "Hebrajczyków 13:8", "lang": "PL"},
  {"text": "Pan patrzy na serce.", "ref": "1 Samuela 16:7", "lang": "PL"},
  {"text": "Pokój temu domowi.", "ref": "Łukasza 10:5", "lang": "PL"},
  {"text": "Bóg jest Opoką.", "ref": "2 Samuela 22:2", "lang": "PL"},
  {"text": "Duch Prawdy nas uczy.", "ref": "Jana 16:13", "lang": "PL"},
  {"text": "Jesteśmy dziećmi Bożymi.", "ref": "Rzymian 8:16", "lang": "PL"},
  {"text": "Pan jest pełen litości.", "ref": "Jakuba 5:11", "lang": "PL"},
