  {"text": "Bóg nas wybawia.", "ref": "Tytusa 3:5", "lang": "PL"},
  {"text": "Pan twoją światłością.", "ref": "Psalm 27:1", "lang": "PL"},
  {"text": "Słowo Boże jest żywe.", "ref": "Hebrajczyków 4:12", "lang": "PL"},
