[
  {"text": "Az Úr az én pásztorom; nem szűkölködöm.", "ref": "Zsoltárok 23:1", "lang": "HU"},
  {"text": "Mindenre van erőm a Krisztusban, aki engem megerősít.", "ref": "Filippi 4:13", "lang": "HU"},
  {"text": "Mert én tudom az én gondolataimat, amelyeket felőletek gondolok, azt mondja az Úr.", "ref": "Jeremiás 29:11", "lang": "HU"},
  {"text": "Isten a mi oltalmunk és erősségünk, igen bizonyos segítség a nyomorúságban.", "ref": "Zsoltárok 46:1", "lang": "HU"},
  {"text": "Bízzál az Úrban teljes szívből, és ne a magad eszére támaszkodj.", "ref": "Példabeszédek 3:5", "lang": "HU"},
  {"text": "Mert úgy szerette Isten e világot, hogy az ő egyszülött Fiát adta.", "ref": "János 3:16", "lang": "HU"},
  {"text": "És íme, én veletek vagyok minden napon a világ végezetéig.", "ref": "Máté 28:20", "lang": "HU"},
  {"text": "Ne félj, mert én veled vagyok; ne csüggedj, mert én vagyok Istened.", "ref": "Ézsaiás 41:10", "lang": "HU"},
  {"text": "Az Úr az én világosságom és üdvösségem: kitől féljek?", "ref": "Zsoltárok 27:1", "lang": "HU"},
  {"text": "Mert hitben járunk, nem látásban.", "ref": "2 Korinthus 5:7", "lang": "HU"},
  {"text": "Kérjetek és adatik néktek; keressetek és találtok; zörgessetek és megnyittatik néktek.", "ref": "Máté 7:7", "lang": "HU"},
  {"text": "Mert tudom, kiben hittem, és meg vagyok győződve.", "ref": "2 Timótheus 1:12", "lang": "HU"},
  {"text": "A szeretet türelmes, jóságos.", "ref": "1 Korinthus 13:4", "lang": "HU"},
  {"text": "Örüljetek az Úrban mindenkor; ismét mondom: örüljetek!", "ref": "Filippi 4:4", "lang": "HU"},
  {"text": "Mert az Úrnál van a kegyelem, és bőséges nála a szabadítás.", "ref": "Zsoltárok 130:7", "lang": "HU"},
  {"text": "Én vagyok az út, az igazság és az élet.", "ref": "János 14:6", "lang": "HU"},
  {"text": "A mi Urunk Jézus Krisztus kegyelme legyen veletek!", "ref": "1 Thesszalonika 5:28", "lang": "HU"},
  {"text": "Békességet hagyok néktek; az én békességemet adom néktek.", "ref": "János 14:27", "lang": "HU"},
  {"text": "Lábam előtt mécses a te igéd, ösvényem világossága.", "ref": "Zsoltárok 119:105", "lang": "HU"},
  {"text": "Legyetek erősek és bátrak, ne féljetek és ne rettegjetek tőlük.", "ref": "5 Mózes 31:6", "lang": "HU"},
  {"text": "Ne szóval szeressünk, se nyelvvel; hanem cselekedettel és valósággal.", "ref": "1 János 3:18", "lang": "HU"},
  {"text": "Az Isten szeretet.", "ref": "1 János 4:8", "lang": "HU"},
  {"text": "Keressétek először Isten országát és az ő igazságát.", "ref": "Máté 6:33", "lang": "HU"},
  {"text": "Az Úr erőt ad az ő népének.", "ref": "Zsoltárok 29:11", "lang": "HU"},
  {"text": "A nyugalom és a bizalom ad nektek erőt.", "ref": "Ézsaiás 30:15", "lang": "HU"},
  {"text": "Elég néked az én kegyelmem; mert az én erőm erőtlenség által végeztetik el.", "ref": "2 Korinthus 12:9", "lang": "HU"},
  {"text": "Ne nyugtalankodjék a ti szívetek: higgyetek Istenben, és higgyetek énbennem.", "ref": "János 14:1", "lang": "HU"},
  {"text": "Mert őbenne élünk, mozgunk és vagyunk.", "ref": "Apcsel 17:28", "lang": "HU"},
  {"text": "Hűséges az Úr, aki megerősít titeket, és megőriz a gonosztól.", "ref": "2 Thesszalonika 3:3", "lang": "HU"},
  {"text": "Aki a szeretetben marad, Istenben marad, és Isten is őbenne.", "ref": "1 János 4:16", "lang": "HU"},
  {"text": "Irgalmas és kegyelmes az Úr, késedelmes a haragra és nagy a szeretete.", "ref": "Zsoltárok 103:8", "lang": "HU"},
  {"text": "Közeledjetek az Istenhez, és közeledni fog hozzátok.", "ref": "Jakab 4:8", "lang": "HU"},
  {"text": "Az embernek elméje tervezi meg útját, de az Úr igazgatja annak lépését.", "ref": "Példabeszédek 16:9", "lang": "HU"},
  {"text": "Jó az Úr azokhoz, akik várják őt.", "ref": "Jeremiás siralmai 3:25", "lang": "HU"},
  {"text": "De én bízom benned, Uram; mondom: Te vagy az én Istenem!", "ref": "Zsoltárok 31:15", "lang": "HU"},
  {"text": "Ne bánkódjatok, mert az Úr öröme a ti erősségetek.", "ref": "Nehémiás 8:10", "lang": "HU"},
  {"text": "Mindennek rendelt ideje van, és ideje van az ég alatt minden akaratnak.", "ref": "Prédikátor 3:1", "lang": "HU"},
  {"text": "A lélek az, ami éltet.", "ref": "János 6:63", "lang": "HU"},
  {"text": "Boldogok, akiknek szívük tiszta, mert ők az Istent meglátják.", "ref": "Máté 5:8", "lang": "HU"},
  {"text": "Ha Isten velünk, kicsoda ellenünk?", "ref": "Róma 8:31", "lang": "HU"},
  {"text": "Közel van az Úr mindenkihez, aki hívja őt, mindenkihez, aki hűséggel hívja őt.", "ref": "Zsoltárok 145:18", "lang": "HU"},
  {"text": "Mi megismertük és elhittük azt a szeretetet, amellyel Isten szeret minket.", "ref": "1 János 4:16", "lang": "HU"},
  {"text": "Szeresd felebarátodat, mint magadat.", "ref": "Márk 12:31", "lang": "HU"},
  {"text": "És teremté az Isten az embert az ő képére.", "ref": "1 Mózes 1:27", "lang": "HU"},
  {"text": "Szüntelenül imádkozzatok.", "ref": "1 Thesszalonika 5:17", "lang": "HU"},
  {"text": "Aki hisz énbennem, ha meghal is, él.", "ref": "János 11:25", "lang": "HU"},
  {"text": "Én vagyok a jó pásztor. A jó pásztor életét adja a juhokért.", "ref": "János 10:11", "lang": "HU"},
  {"text": "Az Úr az én erőm és pajzsom.", "ref": "Zsoltárok 28:7", "lang": "HU"},
  {"text": "Adjatok hálát az Úrnak, mert jó.", "ref": "Zsoltárok 136:1", "lang": "HU"},
  {"text": "Ne félj, mert én megsegítlek!", "ref": "Ézsaiás 41:13", "lang": "HU"},
  {"text": "Az Úr beszéde megmarad örökké.", "ref": "1 Péter 1:25", "lang": "HU"},
  {"text": "Ez a nap az, amelyet az Úr rendelt; örvendezzünk és vigadjunk ezen!", "ref": "Zsoltárok 118:24", "lang": "HU"},
  {"text": "Isten könyörüljön rajtunk és áldjon meg minket.", "ref": "Zsoltárok 67:2", "lang": "HU"},
  {"text": "Adjatok, és néktek is adatik.", "ref": "Lukács 6:38", "lang": "HU"},
  {"text": "Jöjjetek énhozzám mindnyájan, akik megfáradtatok és megterheltettetek.", "ref": "Máté 11:28", "lang": "HU"},
  {"text": "Mert én veled vagyok, hogy megszabadítsalak, mondja az Úr.", "ref": "Jeremiás 1:8", "lang": "HU"},
  {"text": "Megismeritek az igazságot, és az igazság szabaddá tesz titeket.", "ref": "János 8:32", "lang": "HU"},
  {"text": "A hit pedig a remélt dolgoknak a valósága.", "ref": "Zsidók 11:1", "lang": "HU"},
  {"text": "Minden gondotokat őreá vessétek, mert neki gondja van rátok.", "ref": "1 Péter 5:7", "lang": "HU"},
  {"text": "Éljetek békességben; és a szeretetnek és békességnek Istene veletek lesz.", "ref": "2 Korinthus 13:11", "lang": "HU"},
  {"text": "Mert nap és pajzs az Úr Isten.", "ref": "Zsoltárok 84:12", "lang": "HU"},
  {"text": "Szeressétek ellenségeiteket.", "ref": "Máté 5:44", "lang": "HU"},
  {"text": "Szent, szent, szent a Seregek Ura.", "ref": "Ézsaiás 6:3", "lang": "HU"},
  {"text": "Én fiam vagy te; én ma szültelek téged.", "ref": "Zsoltárok 2:7", "lang": "HU"},
  {"text": "Bocsássatok meg, és néktek is megbocsáttatik.", "ref": "Lukács 6:37", "lang": "HU"},
  {"text": "Legyetek irgalmasok, amint a ti Atyátok is irgalmas.", "ref": "Lukács 6:36", "lang": "HU"},
  {"text": "Én vagyok az Alfa és az Ómega, az első és az utolsó.", "ref": "Jelenések 22:13", "lang": "HU"},
  {"text": "Az igaz ember pedig hitből él.", "ref": "Róma 1:17", "lang": "HU"},
  {"text": "Nagy a mi Urunk és hatalmas az ő ereje.", "ref": "Zsoltárok 147:5", "lang": "HU"},
  {"text": "A zörgetőnek megnyittatik.", "ref": "Máté 7:8", "lang": "HU"},
  {"text": "Hűséges az Isten, aki nem hagy titeket erőtökön felül kísérteni.", "ref": "1 Korinthus 10:13", "lang": "HU"},
  {"text": "Szeretlek Uram, én erősségem!", "ref": "Zsoltárok 18:2", "lang": "HU"},
  {"text": "Áldjon meg téged az Úr, és őrizzen meg téged.", "ref": "4 Mózes 6:24", "lang": "HU"},
  {"text": "A hit cselekedetek nélkül holt.", "ref": "Jakab 2:26", "lang": "HU"},
  {"text": "Békesség néktek!", "ref": "János 20:19", "lang": "HU"},
  {"text": "Szólj Uram, mert hallja a te szolgád.", "ref": "1 Sámuel 3:9", "lang": "HU"},
  {"text": "Íme, Isten az én szabadítóm, bízom és nem félek.", "ref": "Ézsaiás 12:2", "lang": "HU"},
  {"text": "Boldogok a szelídek, mert ők öröklik a földet.", "ref": "Máté 5:5", "lang": "HU"},
  {"text": "Az én juhaim hallják az én szómat.", "ref": "János 10:27", "lang": "HU"},
  {"text": "Életem ideje a te kezedben van.", "ref": "Zsoltárok 31:16", "lang": "HU"},
  {"text": "Az Úr az én segítőm, nem félek.", "ref": "Zsidók 13:6", "lang": "HU"},
  {"text": "Uralkodik az Úr; örüljön a föld.", "ref": "Zsoltárok 97:1", "lang": "HU"},
  {"text": "Az ember azt nézi, ami a szeme előtt van, de az Úr azt nézi, ami a szívben van.", "ref": "1 Sámuel 16:7", "lang": "HU"},
  {"text": "Ha kerestek engem, megtaláltok, ha teljes szívvel keresel.", "ref": "Jeremiás 29:13", "lang": "HU"},
  {"text": "Szeresd az Urat, a te Istenedet teljes szívedből.", "ref": "Máté 22:37", "lang": "HU"},
  {"text": "Az Ige testté lett, és lakozék mi közöttünk.", "ref": "János 1:14", "lang": "HU"},
  {"text": "Aki hisz a Fiúban, annak örök élete van.", "ref": "János 3:36", "lang": "HU"},
  {"text": "Semmi sem választhat el minket az Isten szeretetétől.", "ref": "Róma 8:39", "lang": "HU"},
  {"text": "Isten az én szívemnek kősziklája és az én örökségem örökké.", "ref": "Zsoltárok 73:26", "lang": "HU"},
  {"text": "A ti szelídlelkűségetek ismert legyen minden ember előtt. Az Úr közel!", "ref": "Filippi 4:5", "lang": "HU"},
  {"text": "A szeretet képmutatás nélkül való legyen.", "ref": "Róma 12:9", "lang": "HU"},
  {"text": "A Szentlélek tanít meg titeket abban az órában, mit kell mondanotok.", "ref": "Lukács 12:12", "lang": "HU"},
  {"text": "A reménységben örvendezők, a nyomorúságban békességesek, az imádságban állhatatosak legyetek.", "ref": "Róma 12:12", "lang": "HU"},
  {"text": "Mert a te kegyelmed jobb az életnél.", "ref": "Zsoltárok 63:4", "lang": "HU"},
  {"text": "Szentek legyetek minden magatartásotokban.", "ref": "1 Péter 1:15", "lang": "HU"},
  {"text": "Íme, az ajtó előtt állok, és zörgetek.", "ref": "Jelenések 3:20", "lang": "HU"},
  {"text": "Mert az Isten országa igazság, békesség és a Szentlélekben való öröm.", "ref": "Róma 14:17", "lang": "HU"},
  {"text": "Ahol ketten vagy hárman összegyűlnek az én nevemben, ott vagyok közöttük.", "ref": "Máté 18:20", "lang": "HU"},
  {"text": "A ti mennyei Atyátok tudja, hogy szükségetek van minderre.", "ref": "Máté 6:32", "lang": "HU"},
  {"text": "Az Úrnak Lelke van énrajtam.", "ref": "Lukács 4:18", "lang": "HU"},
  {"text": "Istennél minden lehetséges.", "ref": "Máté 19:26", "lang": "HU"},
  {"text": "Uram, én kősziklám, váram és szabadítóm.", "ref": "Zsoltárok 18:3", "lang": "HU"},
  {"text": "A kegyelem és az igazság Jézus Krisztus által lett.", "ref": "János 1:17", "lang": "HU"},
  {"text": "Egymás terhét hordozzátok.", "ref": "Galata 6:2", "lang": "HU"},
  {"text": "A Krisztus beszéde lakozzék bennetek gazdagon.", "ref": "Kolossé 3:16", "lang": "HU"},
  {"text": "Igazságos az Úr minden útjában.", "ref": "Zsoltárok 145:17", "lang": "HU"},
  {"text": "Nagyobb örömöt adsz szívembe, mint amilyen nekik van.", "ref": "Zsoltárok 4:8", "lang": "HU"},
  {"text": "Boldogok az irgalmasok, mert ők irgalmasságot nyernek.", "ref": "Máté 5:7", "lang": "HU"},
  {"text": "Tiszta szívet teremts bennem, ó Isten.", "ref": "Zsoltárok 51:12", "lang": "HU"},
  {"text": "Meggyógyítja a megtört szívűeket.", "ref": "Zsoltárok 147:3", "lang": "HU"},
  {"text": "Taníts meg akaratodat teljesítenem, mert te vagy Istenem.", "ref": "Zsoltárok 143:10", "lang": "HU"},
  {"text": "De te, Uram, pajzsom vagy nekem, dicsőségem.", "ref": "Zsoltárok 3:4", "lang": "HU"},
  {"text": "Uram, hallgasd meg szavamat, amikor hívlak.", "ref": "Zsoltárok 27:7", "lang": "HU"},
  {"text": "Istenem vagy te, hálát adok neked.", "ref": "Zsoltárok 118:28", "lang": "HU"},
  {"text": "Az Úr pedig igazgassa a ti szíveteket az Isten szeretetére.", "ref": "2 Thesszalonika 3:5", "lang": "HU"},
  {"text": "Mert drágának tartalak, becses vagy nekem, és szeretlek.", "ref": "Ézsaiás 43:4", "lang": "HU"},
  {"text": "Az Úr az én oltalmam, Istenem a bizalmam kősziklája.", "ref": "Zsoltárok 94:22", "lang": "HU"},
  {"text": "Semmi felől ne aggódjatok.", "ref": "Filippi 4:6", "lang": "HU"},
  {"text": "Az Úr a mi királyunk, ő szabadít meg minket!", "ref": "Ézsaiás 33:22", "lang": "HU"},
  {"text": "Elégíts meg minket reggel a te kegyelmeddel.", "ref": "Zsoltárok 90:14", "lang": "HU"},
  {"text": "Boldogok, akik sírnak, mert ők megvigasztaltatnak.", "ref": "Máté 5:4", "lang": "HU"},
  {"text": "Aki engem követ, nem jár sötétségben.", "ref": "János 8:12", "lang": "HU"},
  {"text": "Az Úr az én kősziklám és váram.", "ref": "Zsoltárok 144:2", "lang": "HU"},
  {"text": "Isten a mi bizodalmunk.", "ref": "Zsoltárok 62:9", "lang": "HU"},
  {"text": "Eredj el békességgel.", "ref": "Lukács 7:50", "lang": "HU"},
  {"text": "Az Úr öröme a ti erősségetek.", "ref": "Nehémiás 8:10", "lang": "HU"},
  {"text": "Az Úr az igaz Isten.", "ref": "Jeremiás 10:10", "lang": "HU"},
  {"text": "Jó az Úr.", "ref": "Zsoltárok 100:5", "lang": "HU"},
  {"text": "Szeressétek az igazságot és a békességet.", "ref": "Zakariás 8:19", "lang": "HU"},
  {"text": "Szüntelenül imádkozzatok.", "ref": "1 Thesszalonika 5:17", "lang": "HU"},
  {"text": "Bízzál Istenben.", "ref": "Példabeszédek 3:5", "lang": "HU"},
  {"text": "Hűséges az Isten.", "ref": "1 Korinthus 1:9", "lang": "HU"},
  {"text": "Az Úr a te pásztorod.", "ref": "Zsoltárok 23:1", "lang": "HU"},
  {"text": "A Szentlélek a te Vigasztalód.", "ref": "János 14:26", "lang": "HU"},
  {"text": "Jézus az Úr.", "ref": "Róma 10:9", "lang": "HU"},
  {"text": "Szeresd Istent.", "ref": "5 Mózes 6:5", "lang": "HU"},
  {"text": "Ismerd meg Istent.", "ref": "1 János 5:20", "lang": "HU"},
  {"text": "Isten megvéd minket.", "ref": "2 Thesszalonika 3:3", "lang": "HU"},
  {"text": "Reménységünk van Krisztusban.", "ref": "1 Korinthus 15:19", "lang": "HU"},
  {"text": "Az Úr világosság.", "ref": "János 1:5", "lang": "HU"},
  {"text": "A szeretet mindent legyőz.", "ref": "Róma 12:21", "lang": "HU"},
  {"text": "Velünk az Isten.", "ref": "Máté 1:23", "lang": "HU"},
  {"text": "Higgy Krisztusban.", "ref": "Apcsel 16:31", "lang": "HU"},
  {"text": "Keresd a békességet.", "ref": "Zsoltárok 34:15", "lang": "HU"},
  {"text": "Az Úr megsegít téged.", "ref": "Ézsaiás 41:10", "lang": "HU"},
  {"text": "Mindennek megvan a maga ideje.", "ref": "Prédikátor 3:1", "lang": "HU"},
  {"text": "Isten szereti a világot.", "ref": "János 3:16", "lang": "HU"},
  {"text": "A Lélek vezet minket.", "ref": "Róma 8:14", "lang": "HU"},
  {"text": "Krisztus feltámadt.", "ref": "Máté 28:6", "lang": "HU"},
  {"text": "Legyetek türelmesek.", "ref": "Jakab 5:7", "lang": "HU"},
  {"text": "Az imádságnak ereje van.", "ref": "Jakab 5:16", "lang": "HU"},
  {"text": "Isten oltalom.", "ref": "Zsoltárok 46:2", "lang": "HU"},
  {"text": "Az Úr az én pajzsom.", "ref": "Zsoltárok 28:7", "lang": "HU"},
  {"text": "A szeretet a legnagyobb.", "ref": "1 Korinthus 13:13", "lang": "HU"},
  {"text": "Járjatok világosságban.", "ref": "Efezus 5:8", "lang": "HU"},
  {"text": "Hű az Isten az ígéreteiben.", "ref": "Zsidók 10:23", "lang": "HU"},
  {"text": "Szentek legyetek.", "ref": "1 Péter 1:16", "lang": "HU"},
  {"text": "Az Úr elhívott téged.", "ref": "Ézsaiás 43:1", "lang": "HU"},
  {"text": "Krisztus a mi békességünk.", "ref": "Efezus 2:14", "lang": "HU"},
  {"text": "A mi mindennapi kenyerünket add meg nekünk ma.", "ref": "Máté 6:11", "lang": "HU"},
  {"text": "A te igéd igazság.", "ref": "János 17:17", "lang": "HU"},
  {"text": "Bízzál az Úrban.", "ref": "Zsoltárok 37:3", "lang": "HU"},
  {"text": "Isten a mi Atyánk.", "ref": "Máté 6:9", "lang": "HU"},
  {"text": "Isten teremtett mindent.", "ref": "1 Mózes 1:1", "lang": "HU"},
  {"text": "Az Úr jóságos.", "ref": "Zsoltárok 145:9", "lang": "HU"},
  {"text": "Isten hallja a hangodat.", "ref": "Zsoltárok 116:1", "lang": "HU"},
  {"text": "Örök életünk van.", "ref": "1 János 5:13", "lang": "HU"},
  {"text": "Az Úr megerősít téged.", "ref": "2 Thesszalonika 3:3", "lang": "HU"},
  {"text": "Keresd a békét.", "ref": "1 Péter 3:11", "lang": "HU"},
  {"text": "Isten hatalmas.", "ref": "Lukács 1:37", "lang": "HU"},
  {"text": "Jézus szereti a gyermekeket.", "ref": "Máté 19:14", "lang": "HU"},
  {"text": "Erősödjetek meg az Úrban.", "ref": "Efezus 6:10", "lang": "HU"},
  {"text": "A szeretet soha el nem fogy.", "ref": "1 Korinthus 13:8", "lang": "HU"},
  {"text": "Az Úr a te szabadításod.", "ref": "2 Mózes 15:2", "lang": "HU"},
  {"text": "Isten az én királyom.", "ref": "Zsoltárok 44:5", "lang": "HU"},
  {"text": "Szeressétek az igazságot.", "ref": "Zakariás 8:19", "lang": "HU"},
  {"text": "Bocsássatok meg egymásnak.", "ref": "Efezus 4:32", "lang": "HU"},
  {"text": "Isten az élet világossága.", "ref": "János 8:12", "lang": "HU"},
  {"text": "Az Úr a te segítséged.", "ref": "Zsoltárok 121:2", "lang": "HU"},
  {"text": "Kegyelem veletek.", "ref": "2 Korinthus 13:13", "lang": "HU"},
  {"text": "A bizalom békét hoz.", "ref": "Ézsaiás 26:3", "lang": "HU"},
  {"text": "Isten megáld téged.", "ref": "1 Mózes 12:2", "lang": "HU"},
  {"text": "Krisztus a fő.", "ref": "Kolossé 1:18", "lang": "HU"},
  {"text": "Isten országa közel van.", "ref": "Márk 1:15", "lang": "HU"},
  {"text": "Az Úr a te őriződ.", "ref": "Zsoltárok 121:5", "lang": "HU"},
