[
  {"text": "Pán je môj pastier, nič mi nechýba.", "ref": "Žalm 23:1", "lang": "SK"},
  {"text": "Všetko môžem v tom, ktorý ma posilňuje.", "ref": "Filipanom 4:13", "lang": "SK"},
  {"text": "Lebo ja poznám zámery, ktoré mám s vami – hovorí Pán.", "ref": "Jeremiáš 29:11", "lang": "SK"},
  {"text": "Boh je naša útočište a sila, pomoc v súženiach vždy osvedčená.", "ref": "Žalm 46:2", "lang": "SK"},
  {"text": "Dôveruj celým srdcom Pánovi a nespoliehaj sa na svoj um.", "ref": "Príslovia 3:5", "lang": "SK"},
  {"text": "Lebo tak Boh miloval svet, že dal svojho jednorodeného Syna.", "ref": "Ján 3:16", "lang": "SK"},
  {"text": "A hľa, ja som s vami po všetky dni až do skončenia sveta.", "ref": "Matúš 28:20", "lang": "SK"},
  {"text": "Neboj sa, veď som s tebou ja, neobzeraj sa, veď ja som tvoj Boh.", "ref": "Izaiáš 41:10", "lang": "SK"},
  {"text": "Pán je moje svetlo a moja spása, koho sa mám báť?", "ref": "Žalm 27:1", "lang": "SK"},
  {"text": "Svojou vierou kráčame, nie videním.", "ref": "2. Korinťanom 5:7", "lang": "SK"},
  {"text": "Proste a dostanete! Hľadajte a nájdete! Klopte a otvoria vám!", "ref": "Matúš 7:7", "lang": "SK"},
  {"text": "Viem, komu som uveril, a som si istý.", "ref": "2. Timotejovi 1:12", "lang": "SK"},
  {"text": "Láska je trpezlivá, láska je dobrotivá.", "ref": "1. Korinťanom 13:4", "lang": "SK"},
  {"text": "Radujte sa v Pánovi vždy! Opakujem: Radujte sa!", "ref": "Filipanom 4:4", "lang": "SK"},
  {"text": "U Pána je milosrdenstvo a hojné vykúpenie.", "ref": "Žalm 130:7", "lang": "SK"},
  {"text": "Ja som cesta, pravda a život.", "ref": "Ján 14:6", "lang": "SK"},
  {"text": "Milosť nášho Pána Ježiša Krista nech je s vami.", "ref": "1. Tesaloničanom 5:28", "lang": "SK"},
  {"text": "Pokoj vám zanechávam, svoj pokoj vám dávam.", "ref": "Ján 14:27", "lang": "SK"},
  {"text": "Tvoje slovo je svetlo pre moje nohy a pochodeň na mojich chodníkoch.", "ref": "Žalm 119:105", "lang": "SK"},
  {"text": "Buďte silní a zmužilí, nebojte sa a neľakajte sa ich.", "ref": "Deuteronómium 31:6", "lang": "SK"},
  {"text": "Menej hovoriť a viac milovať.", "ref": "1. Jánov 3:18", "lang": "SK"},
  {"text": "Boh je láska.", "ref": "1. Jánov 4:8", "lang": "SK"},
  {"text": "Hľadajte najprv Božie kráľovstvo a jeho spravodlivosť.", "ref": "Matúš 6:33", "lang": "SK"},
  {"text": "Pán dáva silu svojmu ľudu.", "ref": "Žalm 29:11", "lang": "SK"},
  {"text": "V tichosti a nádeji bude vaša sila.", "ref": "Izaiáš 30:15", "lang": "SK"},
  {"text": "Moja milosť ti stačí, lebo sila sa dokonale prejavuje v slabosti.", "ref": "2. Korinťanom 12:9", "lang": "SK"},
  {"text": "Nech sa vám srdce nevzrušuje. Verte v Boha a verte aj vo mňa.", "ref": "Ján 14:1", "lang": "SK"},
  {"text": "Lebo v ňom žijeme, hýbeme sa a sme.", "ref": "Skutky 17:28", "lang": "SK"},
  {"text": "Pán je verný, on vás utvrdí a ochráni pred Zlým.", "ref": "2. Tesaloničanom 3:3", "lang": "SK"},
  {"text": "Kto ostáva v láske, ostáva v Bohu a Boh ostáva v ňom.", "ref": "1. Jánov 4:16", "lang": "SK"},
  {"text": "Milosrdný a milostivý je Pán, zhovievavý a veľmi ľútostivý.", "ref": "Žalm 103:8", "lang": "SK"},
  {"text": "Priblížte sa k Bohu a on sa priblíži k vám.", "ref": "Jakub 4:8", "lang": "SK"},
  {"text": "Srdce človeka si plánuje cestu, ale Pán riadi jeho kroky.", "ref": "Príslovia 16:9", "lang": "SK"},
  {"text": "Dobrotivý je Pán k tým, čo v neho dúfajú.", "ref": "Náreky 3:25", "lang": "SK"},
  {"text": "Na teba sa spolieham, Pane, hovorím: Ty si môj Boh.", "ref": "Žalm 31:15", "lang": "SK"},
  {"text": "Nebuď smutný, lebo radosť v Pánovi je vaša sila.", "ref": "Nehemiáš 8:10", "lang": "SK"},
  {"text": "Všetko má svoj čas a každé počínanie pod nebom má svoju chvíľu.", "ref": "Kazateľ 3:1", "lang": "SK"},
  {"text": "Duch je ten, ktorý oživuje.", "ref": "Ján 6:63", "lang": "SK"},
  {"text": "Blahoslavení čistého srdca, lebo oni uvidia Boha.", "ref": "Matúš 5:8", "lang": "SK"},
  {"text": "Ak je Boh za nás, kto je proti nám?", "ref": "Rimanom 8:31", "lang": "SK"},
  {"text": "Pán je blízko všetkým, čo ho vzývajú úprimne.", "ref": "Žalm 145:18", "lang": "SK"},
  {"text": "V neho sme uverili, a tak sme spoznali lásku.", "ref": "1. Jánov 4:16", "lang": "SK"},
  {"text": "Miluj svojho blížneho ako seba samého.", "ref": "Marek 12:31", "lang": "SK"},
  {"text": "Boh stvoril človeka na svoj obraz.", "ref": "Genezis 1:27", "lang": "SK"},
  {"text": "Neprestajne sa modlite.", "ref": "1. Tesaloničanom 5:17", "lang": "SK"},
  {"text": "Kto verí vo mňa, bude žiť, aj keď umrie.", "ref": "Ján 11:25", "lang": "SK"},
  {"text": "Ja som dobrý pastier. Dobrý pastier položí svoj život za ovce.", "ref": "Ján 10:11", "lang": "SK"},
  {"text": "Pán je moja sila a môj štít.", "ref": "Žalm 28:7", "lang": "SK"},
  {"text": "Chváľte Pána, lebo je dobrý.", "ref": "Žalm 136:1", "lang": "SK"},
  {"text": "Neboj sa, ja ti pomôžem.", "ref": "Izaiáš 41:13", "lang": "SK"},
  {"text": "Slovo Pánovo trvá naveky.", "ref": "1. Petrov 1:25", "lang": "SK"},
  {"text": "Toto je deň, ktorý učinil Pán, plesajme a radujme sa z neho.", "ref": "Žalm 118:24", "lang": "SK"},
  {"text": "Boh nech je vám milostivý a nech vám žehná.", "ref": "Žalm 67:2", "lang": "SK"},
  {"text": "Dávajte a dajú vám.", "ref": "Lukáš 6:38", "lang": "SK"},
  {"text": "Poďte ku mne všetci, ktorí sa namáhate a ste preťažení.", "ref": "Matúš 11:28", "lang": "SK"},
  {"text": "Ja som s tebou, aby som ťa vyslobodil.", "ref": "Jeremiáš 1:8", "lang": "SK"},
  {"text": "Poznajte pravdu a pravda vás vyslobodí.", "ref": "Ján 8:32", "lang": "SK"},
  {"text": "Viera je základom toho, v čo dúfame.", "ref": "Hebrejom 11:1", "lang": "SK"},
  {"text": "Všetky svoje starosti odovzdajte jemu, lebo on sa o vás stará.", "ref": "1. Petrov 5:7", "lang": "SK"},
  {"text": "Žite v pokoji a Boh lásky a pokoja bude s vami.", "ref": "2. Korinťanom 13:11", "lang": "SK"},
  {"text": "Pán Boh je slnko a štít.", "ref": "Žalm 84:12", "lang": "SK"},
  {"text": "Milujte svojich nepriateľov.", "ref": "Matúš 5:44", "lang": "SK"},
  {"text": "Svätý, svätý, svätý je Pán zástupov.", "ref": "Izaiáš 6:3", "lang": "SK"},
  {"text": "Ty si môj syn, ja som ťa dnes splodil.", "ref": "Žalm 2:7", "lang": "SK"},
  {"text": "Odpúšťajte a odpustí sa vám.", "ref": "Lukáš 6:37", "lang": "SK"},
  {"text": "Buďte milosrdní, ako je milosrdný váš Otec.", "ref": "Lukáš 6:36", "lang": "SK"},
  {"text": "Ja som Alfa i Omega, prvý i posledný.", "ref": "Zjavenie 22:13", "lang": "SK"},
  {"text": "Spravodlivý žije z viery.", "ref": "Rimanom 1:17", "lang": "SK"},
  {"text": "Veľký je náš Pán a nesmierna je jeho moc.", "ref": "Žalm 147:5", "lang": "SK"},
  {"text": "Kto klope, tomu otvoria.", "ref": "Matúš 7:8", "lang": "SK"},
  {"text": "Boh je verný a nedovolí, aby ste boli skúšaní nad svoje sily.", "ref": "1. Korinťanom 10:13", "lang": "SK"},
  {"text": "Teba milujem, Pane, moja sila.", "ref": "Žalm 18:2", "lang": "SK"},
  {"text": "Pán nech ti žehná a nech ťa ochraňuje.", "ref": "Numeri 6:24", "lang": "SK"},
  {"text": "Viera bez skutkov je mŕtva.", "ref": "Jakub 2:26", "lang": "SK"},
  {"text": "Pokoj vám!", "ref": "Ján 20:19", "lang": "SK"},
  {"text": "Hovor, Pane, tvoj sluha počúva.", "ref": "1. Samuelova 3:9", "lang": "SK"},
  {"text": "Pán je moja spása, nebudem sa báť.", "ref": "Izaiáš 12:2", "lang": "SK"},
  {"text": "Blahoslavení tichí, lebo oni budú dedičmi zeme.", "ref": "Matúš 5:5", "lang": "SK"},
  {"text": "Moje ovce počúvajú môj hlas.", "ref": "Ján 10:27", "lang": "SK"},
  {"text": "V tvojej ruke sú moje časy.", "ref": "Žalm 31:16", "lang": "SK"},
  {"text": "Pán je môj pomocník, nebudem sa báť.", "ref": "Hebrejom 13:6", "lang": "SK"},
  {"text": "Pán kraľuje, nech zaplesá zem.", "ref": "Žalm 97:1", "lang": "SK"},
  {"text": "Boh nevidí tak ako človek; človek hľadí na zovňajšok, Pán hľadí na srdce.", "ref": "1. Samuelova 16:7", "lang": "SK"},
  {"text": "Budete ma hľadať a nájdete ma, ak ma budete hľadať celým srdcom.", "ref": "Jeremiáš 29:13", "lang": "SK"},
  {"text": "Miluj Pána, svojho Boha, celým svojím srdcom.", "ref": "Matúš 22:37", "lang": "SK"},
  {"text": "Slovo sa telom stalo a prebývalo medzi nami.", "ref": "Ján 1:14", "lang": "SK"},
  {"text": "Kto verí v Syna, má večný život.", "ref": "Ján 3:36", "lang": "SK"},
  {"text": "Nič nás nemôže odlúčiť od Božej lásky.", "ref": "Rimanom 8:39", "lang": "SK"},
  {"text": "Pán je skala môjho srdca a môj podiel naveky.", "ref": "Žalm 73:26", "lang": "SK"},
  {"text": "Vaša miernosť nech je známa všetkým ľuďom. Pán je blízko.", "ref": "Filipanom 4:5", "lang": "SK"},
  {"text": "Láska nech je bez pretvárky.", "ref": "Rimanom 12:9", "lang": "SK"},
  {"text": "Pán vás naučí, čo máte hovoriť.", "ref": "Lukáš 12:12", "lang": "SK"},
  {"text": "V nádeji sa radujte, v súžení buďte trpezliví, v modlitbe vytrvalí.", "ref": "Rimanom 12:12", "lang": "SK"},
  {"text": "Tvoje milosrdenstvo je lepšie ako život.", "ref": "Žalm 63:4", "lang": "SK"},
  {"text": "Svätým sa staňte vo všetkom svojom počínaní.", "ref": "1. Petrov 1:15", "lang": "SK"},
  {"text": "Hľa, klopem pri dverách. Kto otvorí, k tomu vojdem.", "ref": "Zjavenie 3:20", "lang": "SK"},
  {"text": "Lebo kráľovstvo Božie je spravodlivosť, pokoj a radosť v Duchu Svätom.", "ref": "Rimanom 14:17", "lang": "SK"},
  {"text": "Kde sú dvaja alebo traja zhromaždení v mojom mene, tam som ja medzi nimi.", "ref": "Matúš 18:20", "lang": "SK"},
  {"text": "Otec nebeský vie, čo potrebujete.", "ref": "Matúš 6:32", "lang": "SK"},
  {"text": "Duch Pánov je nado mnou.", "ref": "Lukáš 4:18", "lang": "SK"},
  {"text": "U Boha je možné všetko.", "ref": "Matúš 19:26", "lang": "SK"},
  {"text": "Pán je mojou skalou, mojím hradom a mojím vysloboditeľom.", "ref": "Žalm 18:3", "lang": "SK"},
  {"text": "Milosť a pravda prišli skrze Ježiša Krista.", "ref": "Ján 1:17", "lang": "SK"},
  {"text": "Neste si vzájomne bremená.", "ref": "Galaťanom 6:2", "lang": "SK"},
  {"text": "Slovo Kristovo nech vo vás prebýva bohato.", "ref": "Kolosanom 3:16", "lang": "SK"},
  {"text": "Pán je spravodlivý vo všetkých svojich cestách.", "ref": "Žalm 145:17", "lang": "SK"},
  {"text": "Od teba pochádza radosť srdca.", "ref": "Žalm 4:8", "lang": "SK"},
  {"text": "Blahoslavení milosrdní, lebo oni dosiahnu milosrdenstvo.", "ref": "Matúš 5:7", "lang": "SK"},
  {"text": "Stvor mi srdce čisté, o Bože.", "ref": "Žalm 51:12", "lang": "SK"},
  {"text": "On uzdravuje skľúčených srdcom.", "ref": "Žalm 147:3", "lang": "SK"},
  {"text": "Uč ma plniť tvoju vôľu, veď ty si môj Boh.", "ref": "Žalm 143:10", "lang": "SK"},
  {"text": "Pán je môj štít a moja sláva.", "ref": "Žalm 3:4", "lang": "SK"},
  {"text": "Vypočuj, Pane, môj hlas, keď volám.", "ref": "Žalm 27:7", "lang": "SK"},
  {"text": "Ty si môj Boh, tebe ďakujem.", "ref": "Žalm 118:28", "lang": "SK"},
  {"text": "Pán nech riadi vaše srdcia k Božej láske.", "ref": "2. Tesaloničanom 3:5", "lang": "SK"},
  {"text": "Drahý si v mojich očiach, vzácny a ja ťa milujem.", "ref": "Izaiáš 43:4", "lang": "SK"},
  {"text": "Pán je moje útočište, Boh je skala mojej spásy.", "ref": "Žalm 94:22", "lang": "SK"},
  {"text": "Nebuďte ustarostení o nič.", "ref": "Filipanom 4:6", "lang": "SK"},
  {"text": "Pán je náš kráľ, on nás spasí.", "ref": "Izaiáš 33:22", "lang": "SK"},
  {"text": "V tvojej dobrote nás sýť hneď zrána.", "ref": "Žalm 90:14", "lang": "SK"},
  {"text": "Blahoslavení, ktorí plačú, lebo oni budú potešení.", "ref": "Matúš 5:4", "lang": "SK"},
  {"text": "Kto mňa nasleduje, nebude chodiť v tmách.", "ref": "Ján 8:12", "lang": "SK"},
  {"text": "Pán je môj pevný hrad.", "ref": "Žalm 144:2", "lang": "SK"},
  {"text": "Boh je náš úkryt.", "ref": "Žalm 62:9", "lang": "SK"},
  {"text": "Choďte v pokoji.", "ref": "Lukáš 7:50", "lang": "SK"},
  {"text": "Božia radosť je tvoja sila.", "ref": "Nehemiáš 8:10", "lang": "SK"},
  {"text": "Pán je pravdivý.", "ref": "Jeremiáš 10:10", "lang": "SK"},
  {"text": "Boh je dobrý.", "ref": "Žalm 100:5", "lang": "SK"},
  {"text": "Miluj pravdu.", "ref": "Zachariáš 8:19", "lang": "SK"},
  {"text": "Modlite sa bez prestania.", "ref": "1. Tesaloničanom 5:17", "lang": "SK"},
  {"text": "Dôveruj Bohu.", "ref": "Príslovia 3:5", "lang": "SK"},
  {"text": "Pán je verný.", "ref": "1. Korinťanom 1:9", "lang": "SK"},
  {"text": "Boh je tvoj pastier.", "ref": "Žalm 23:1", "lang": "SK"},
  {"text": "Duch svätý je tvoj tešiteľ.", "ref": "Ján 14:26", "lang": "SK"},
  {"text": "Ježiš je Pán.", "ref": "Rimanom 10:9", "lang": "SK"},
  {"text": "Miluj Boha.", "ref": "Deuteronómium 6:5", "lang": "SK"},
  {"text": "Spoznaj Boha.", "ref": "1. Jánov 5:20", "lang": "SK"},
  {"text": "Boh nás chráni.", "ref": "2. Tesaloničanom 3:3", "lang": "SK"},
  {"text": "Máme nádej v Kristovi.", "ref": "1. Korinťanom 15:19", "lang": "SK"},
  {"text": "Pán je svetlo.", "ref": "Ján 1:5", "lang": "SK"},
  {"text": "Láska víťazí.", "ref": "Rimanom 12:21", "lang": "SK"},
  {"text": "Boh je s nami.", "ref": "Matúš 1:23", "lang": "SK"},
  {"text": "Ver v Krista.", "ref": "Skutky 16:31", "lang": "SK"},
  {"text": "Hľadaj mier.", "ref": "Žalm 34:15", "lang": "SK"},
  {"text": "Pán ti pomôže.", "ref": "Izaiáš 41:10", "lang": "SK"},
  {"text": "Všetko má svoj čas.", "ref": "Kazateľ 3:1", "lang": "SK"},
  {"text": "Boh miluje svet.", "ref": "Ján 3:16", "lang": "SK"},
  {"text": "Duch nás vedie.", "ref": "Rimanom 8:14", "lang": "SK"},
  {"text": "Kristus vstal z mŕtvych.", "ref": "Matúš 28:6", "lang": "SK"},
  {"text": "Buďte trpezliví.", "ref": "Jakub 5:7", "lang": "SK"},
  {"text": "Modlitba má moc.", "ref": "Jakub 5:16", "lang": "SK"},
  {"text": "Boh je útočište.", "ref": "Žalm 46:2", "lang": "SK"},
  {"text": "Pán je môj štít.", "ref": "Žalm 28:7", "lang": "SK"},
  {"text": "Láska je najväčšia.", "ref": "1. Korinťanom 13:13", "lang": "SK"},
  {"text": "Ži vo svetle.", "ref": "Efezanom 5:8", "lang": "SK"},
  {"text": "Boh je verný prísľubom.", "ref": "Hebrejom 10:23", "lang": "SK"},
  {"text": "Buď svätý.", "ref": "1. Petrov 1:16", "lang": "SK"},
  {"text": "Pán ťa povolal.", "ref": "Izaiáš 43:1", "lang": "SK"},
  {"text": "Kristus je náš pokoj.", "ref": "Efezanom 2:14", "lang": "SK"},
  {"text": "Daj nám chlieb náš každodenný.", "ref": "Matúš 6:11", "lang": "SK"},
  {"text": "Božie slovo je pravda.", "ref": "Ján 17:17", "lang": "SK"},
  {"text": "Dôveruj Pánovi.", "ref": "Žalm 37:3", "lang": "SK"},
  {"text": "Boh je náš Otec.", "ref": "Matúš 6:9", "lang": "SK"},
  {"text": "Všetko stvoril Boh.", "ref": "Genezis 1:1", "lang": "SK"},
  {"text": "Pán je dobrotivý.", "ref": "Žalm 145:9", "lang": "SK"},
  {"text": "Boh počuje tvoj hlas.", "ref": "Žalm 116:1", "lang": "SK"},
  {"text": "Máme večný život.", "ref": "1. Jánov 5:13", "lang": "SK"},
  {"text": "Pán ťa posilní.", "ref": "2. Tesaloničanom 3:3", "lang": "SK"},
  {"text": "Hľadajte pokoj.", "ref": "1. Petrov 3:11", "lang": "SK"},
  {"text": "Boh je mocný.", "ref": "Lukáš 1:37", "lang": "SK"},
  {"text": "Ježiš miluje deti.", "ref": "Matúš 19:14", "lang": "SK"},
  {"text": "Buď silný v Pánovi.", "ref": "Efezanom 6:10", "lang": "SK"},
  {"text": "Láska nepominie.", "ref": "1. Korinťanom 13:8", "lang": "SK"},
  {"text": "Pán je tvoja spása.", "ref": "Exodus 15:2", "lang": "SK"},
  {"text": "Boh je môj kráľ.", "ref": "Žalm 44:5", "lang": "SK"},
  {"text": "Miluj pravdu a pokoj.", "ref": "Zachariáš 8:19", "lang": "SK"},
  {"text": "Odpúšťajme si.", "ref": "Efezanom 4:32", "lang": "SK"},
  {"text": "Boh je svetlo života.", "ref": "Ján 8:12", "lang": "SK"},
  {"text": "Pán je tvoja pomoc.", "ref": "Žalm 121:2", "lang": "SK"},
  {"text": "Milosť je s tebou.", "ref": "2. Korinťanom 13:13", "lang": "SK"},
  {"text": "Dôvera prináša pokoj.", "ref": "Izaiáš 26:3", "lang": "SK"},
  {"text": "Boh ti žehná.", "ref": "Genezis 12:2", "lang": "SK"},
  {"text": "Kristus je hlava.", "ref": "Kolosanom 1:18", "lang": "SK"},
  {"text": "Božie kráľovstvo je blízko.", "ref": "Marek 1:15", "lang": "SK"},
  {"text": "Pán je tvoj strážca.", "ref": "Žalm 121:5", "lang": "SK"},
  {"text": "Vierou hory prenášame.", "ref": "Matúš 17:20", "lang": "SK"},
  {"text": "Boh ti dáva radosť.", "ref": "Žalm 16:11", "lang": "SK"},
  {"text": "Ježiš je ten istý včera i dnes.", "ref": "Hebrejom 13:8", "lang": "SK"},
  {"text": "Pán hľadí na srdce.", "ref": "1. Samuelova 16:7", "lang": "SK"},
  {"text": "Pokoj tvojmu domu.", "ref": "Lukáš 10:5", "lang": "SK"},
  {"text": "Boh je skala.", "ref": "2. Samuelova 22:2", "lang": "SK"},
  {"text": "Duch pravdy nás učí.", "ref": "Ján 16:13", "lang": "SK"},
  {"text": "Sme Božími deťmi.", "ref": "Rimanom 8:16", "lang": "SK"},
  {"text": "Pán je milosrdný.", "ref": "Jakub 5:11", "lang": "SK"},
  {"text": "Božia láska nás spája.", "ref": "Kolosanom 3:14", "lang": "SK"},
  {"text": "Ver a uvidíš slávu.", "ref": "Ján 11:40", "lang": "SK"},
  {"text": "Kristus v nás, nádej slávy.", "ref": "Kolosanom 1:27", "lang": "SK"},
