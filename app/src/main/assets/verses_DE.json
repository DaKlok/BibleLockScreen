[
  {"text": "Der Herr ist mein Hirte, mir wird nichts mangeln.", "ref": "Psalm 23:1", "lang": "DE"},
  {"text": "Ich vermag alles durch den, der mich mächtig macht.", "ref": "Philipper 4:13", "lang": "DE"},
  {"text": "Denn ich weiß wohl, was ich für Gedanken über euch habe, spricht der Herr.", "ref": "Jeremia 29:11", "lang": "DE"},
  {"text": "Gott ist unsere Zuversicht und Stärke, eine Hilfe in den großen Nöten.", "ref": "Psalm 46:2", "lang": "DE"},
  {"text": "Verlass dich auf den Herrn von ganzem Herzen, und verlass dich nicht auf deinen Verstand.", "ref": "Sprüche 3:5", "lang": "DE"},
  {"text": "Denn also hat Gott die Welt geliebt, dass er seinen eingeborenen Sohn gab.", "ref": "Johannes 3:16", "lang": "DE"},
  {"text": "Und siehe, ich bin bei euch alle Tage bis an der Welt Ende.", "ref": "Matthäus 28:20", "lang": "DE"},
  {"text": "Fürchte dich nicht, ich bin mit dir; weiche nicht, denn ich bin dein Gott.", "ref": "Jesaja 41:10", "lang": "DE"},
  {"text": "Der Herr ist mein Licht und mein Heil; vor wem sollte ich mich fürchten?", "ref": "Psalm 27:1", "lang": "DE"},
  {"text": "Denn wir wandeln im Glauben und nicht im Schauen.", "ref": "2 Korinther 5:7", "lang": "DE"},
  {"text": "Bittet, so wird euch gegeben; suchet, so werdet ihr finden; klopfet an, so wird euch aufgetan.", "ref": "Matthäus 7:7", "lang": "DE"},
  {"text": "Ich weiß, an wen ich glaube, und ich bin gewiss.", "ref": "2 Timotheus 1:12", "lang": "DE"},
  {"text": "Die Liebe ist langmütig und freundlich.", "ref": "1 Korinther 13:4", "lang": "DE"},
  {"text": "Freuet euch in dem Herrn allewege, und abermals sage ich: Freuet euch!", "ref": "Philipper 4:4", "lang": "DE"},
  {"text": "Denn bei dem Herrn ist die Gnade und viel Erlösung bei ihm.", "ref": "Psalm 130:7", "lang": "DE"},
  {"text": "Ich bin der Weg und die Wahrheit und das Leben.", "ref": "Johannes 14:6", "lang": "DE"},
  {"text": "Die Gnade unseres Herrn Jesus Christus sei mit euch!", "ref": "1 Thessalonicher 5:28", "lang": "DE"},
  {"text": "Den Frieden lasse ich euch, meinen Frieden gebe ich euch.", "ref": "Johannes 14:27", "lang": "DE"},
  {"text": "Dein Wort ist meines Fußes Leuchte und ein Licht auf meinem Wege.", "ref": "Psalm 119:105", "lang": "DE"},
  {"text": "Seid getrost und unverzagt, fürchtet euch nicht und lasst euch nicht vor ihnen grauen.", "ref": "5 Mose 31:6", "lang": "DE"},
  {"text": "Lasst uns nicht lieben mit Worten noch mit der Zunge, sondern mit der Tat und mit der Wahrheit.", "ref": "1 Johannes 3:18", "lang": "DE"},
  {"text": "Gott ist die Liebe.", "ref": "1 Johannes 4:8", "lang": "DE"},
  {"text": "Trachtet zuerst nach dem Reich Gottes und nach seiner Gerechtigkeit.", "ref": "Matthäus 6:33", "lang": "DE"},
  {"text": "Der Herr wird seinem Volk Kraft geben.", "ref": "Psalm 29:11", "lang": "DE"},
  {"text": "Durch Stillesein und Hoffen würdet ihr stark sein.", "ref": "Jesaja 30:15", "lang": "DE"},
  {"text": "Lass dir an meiner Gnade genügen; denn meine Kraft ist in den Schwachen mächtig.", "ref": "2 Korinther 12:9", "lang": "DE"},
  {"text": "Euer Herz erschrecke nicht! Glaubt an Gott und glaubt an mich.", "ref": "Johannes 14:1", "lang": "DE"},
  {"text": "Denn in ihm leben, weben und sind wir.", "ref": "Apostelgeschichte 17:28", "lang": "DE"},
  {"text": "Aber der Herr ist treu; der wird euch stärken und bewahren vor dem Bösen.", "ref": "2 Thessalonicher 3:3", "lang": "DE"},
  {"text": "Wer in der Liebe bleibt, der bleibt in Gott und Gott in ihm.", "ref": "1 Johannes 4:16", "lang": "DE"},
  {"text": "Barmherzig und gnädig ist der Herr, geduldig und von großer Güte.", "ref": "Psalm 103:8", "lang": "DE"},
  {"text": "Naht euch zu Gott, so naht er sich zu euch.", "ref": "Jakobus 4:8", "lang": "DE"},
  {"text": "Des Menschen Herz plant seinen Weg, aber der Herr allein lenkt seinen Schritt.", "ref": "Sprüche 16:9", "lang": "DE"},
  {"text": "Der Herr ist gütig dem, der auf ihn harrt.", "ref": "Klagelieder 3:25", "lang": "DE"},
  {"text": "Ich aber, Herr, hoffe auf dich und spreche: Du bist mein Gott!", "ref": "Psalm 31:15", "lang": "DE"},
  {"text": "Seid nicht bekümmert; denn die Freude am Herrn ist eure Stärke.", "ref": "Nehemia 8:10", "lang": "DE"},
  {"text": "Ein jegliches hat seine Zeit, und alles Vorhaben unter dem Himmel hat seine Stunde.", "ref": "Prediger 3:1", "lang": "DE"},
  {"text": "Der Geist ist's, der lebendig macht.", "ref": "Johannes 6:63", "lang": "DE"},
  {"text": "Selig sind, die reinen Herzens sind; denn sie werden Gott schauen.", "ref": "Matthäus 5:8", "lang": "DE"},
  {"text": "Ist Gott für uns, wer mag wider uns sein?", "ref": "Römer 8:31", "lang": "DE"},
  {"text": "Der Herr ist nahe allen, die ihn anrufen, allen, die ihn ernstlich anrufen.", "ref": "Psalm 145:18", "lang": "DE"},
  {"text": "Und wir haben erkannt und geglaubt die Liebe, die Gott zu uns hat.", "ref": "1 Johannes 4:16", "lang": "DE"},
  {"text": "Du sollst deinen Nächsten lieben wie dich selbst.", "ref": "Markus 12:31", "lang": "DE"},
  {"text": "Und Gott schuf den Menschen zu seinem Bilde.", "ref": "1 Mose 1:27", "lang": "DE"},
  {"text": "Betet ohne Unterlass.", "ref": "1 Thessalonicher 5:17", "lang": "DE"},
  {"text": "Wer an mich glaubt, der wird leben, auch wenn er stirbt.", "ref": "Johannes 11:25", "lang": "DE"},
  {"text": "Ich bin der gute Hirte. Der gute Hirte lässt sein Leben für die Schafe.", "ref": "Johannes 10:11", "lang": "DE"},
  {"text": "Der Herr ist meine Stärke und mein Schild.", "ref": "Psalm 28:7", "lang": "DE"},
  {"text": "Danket dem Herrn, denn er ist freundlich.", "ref": "Psalm 136:1", "lang": "DE"},
  {"text": "Fürchte dich nicht, ich helfe dir!", "ref": "Jesaja 41:13", "lang": "DE"},
  {"text": "Des Herrn Wort bleibt in Ewigkeit.", "ref": "1 Petrus 1:25", "lang": "DE"},
  {"text": "Dies ist der Tag, den der Herr macht; lasst uns freuen und fröhlich an ihm sein.", "ref": "Psalm 118:24", "lang": "DE"},
  {"text": "Gott sei uns gnädig und segne uns.", "ref": "Psalm 67:2", "lang": "DE"},
  {"text": "Gebt, so wird euch gegeben.", "ref": "Lukas 6:38", "lang": "DE"},
  {"text": "Kommt her zu mir, alle, die ihr mühselig und beladen seid.", "ref": "Matthäus 11:28", "lang": "DE"},
  {"text": "Denn ich bin mit dir, dass ich dich errette, spricht der Herr.", "ref": "Jeremia 1:8", "lang": "DE"},
  {"text": "Ihr werdet die Wahrheit erkennen, und die Wahrheit wird euch frei machen.", "ref": "Johannes 8:32", "lang": "DE"},
  {"text": "Es ist aber der Glaube eine feste Zuversicht auf das, was man hofft.", "ref": "Hebräer 11:1", "lang": "DE"},
  {"text": "Alle eure Sorge werft auf ihn; denn er sorgt für euch.", "ref": "1 Petrus 5:7", "lang": "DE"},
  {"text": "Haltet Frieden! So wird der Gott der Liebe und des Friedens mit euch sein.", "ref": "2 Korinther 13:11", "lang": "DE"},
  {"text": "Denn Gott der Herr ist Sonne und Schild.", "ref": "Psalm 84:12", "lang": "DE"},
  {"text": "Liebt eure Feinde.", "ref": "Matthäus 5:44", "lang": "DE"},
  {"text": "Heilig, heilig, heilig ist der Herr Zebaoth.", "ref": "Jesaja 6:3", "lang": "DE"},
  {"text": "Du bist mein Sohn, heute habe ich dich gezeugt.", "ref": "Psalm 2:7", "lang": "DE"},
  {"text": "Vergebt, so wird euch vergeben.", "ref": "Lukas 6:37", "lang": "DE"},
  {"text": "Seid barmherzig, wie auch euer Vater barmherzig ist.", "ref": "Lukas 6:36", "lang": "DE"},
  {"text": "Ich bin das A und das O, der Erste und der Letzte.", "ref": "Offenbarung 22:13", "lang": "DE"},
  {"text": "Der Gerechte wird aus Glauben leben.", "ref": "Römer 1:17", "lang": "DE"},
  {"text": "Groß ist unser Herr und mächtig an Kraft.", "ref": "Psalm 147:5", "lang": "DE"},
  {"text": "Wer da anklopft, dem wird aufgetan.", "ref": "Matthäus 7:8", "lang": "DE"},
  {"text": "Gott ist treu, der euch nicht versuchen lässt über eure Kraft.", "ref": "1 Korinther 10:13", "lang": "DE"},
  {"text": "Herzlich lieb habe ich dich, Herr, meine Stärke!", "ref": "Psalm 18:2", "lang": "DE"},
  {"text": "Der Herr segne dich und behüte dich.", "ref": "4 Mose 6:24", "lang": "DE"},
  {"text": "Der Glaube ohne Werke ist tot.", "ref": "Jakobus 2:26", "lang": "DE"},
  {"text": "Friede sei mit euch!", "ref": "Johannes 20:19", "lang": "DE"},
  {"text": "Rede, Herr, denn dein Knecht hört.", "ref": "1 Samuel 3:9", "lang": "DE"},
  {"text": "Siehe, Gott ist mein Heil, ich bin sicher und fürchte mich nicht.", "ref": "Jesaja 12:2", "lang": "DE"},
  {"text": "Selig sind die Sanftmütigen; denn sie werden das Erdreich besitzen.", "ref": "Matthäus 5:5", "lang": "DE"},
  {"text": "Meine Schafe hören meine Stimme.", "ref": "Johannes 10:27", "lang": "DE"},
  {"text": "Meine Zeit steht in deinen Händen.", "ref": "Psalm 31:16", "lang": "DE"},
  {"text": "Der Herr ist mein Helfer, ich will mich nicht fürchten.", "ref": "Hebräer 13:6", "lang": "DE"},
  {"text": "Der Herr ist König; des freue sich das Erdreich.", "ref": "Psalm 97:1", "lang": "DE"},
  {"text": "Ein Mensch sieht, was vor Augen ist; der Herr aber sieht das Herz an.", "ref": "1 Samuel 16:7", "lang": "DE"},
  {"text": "Wenn ihr mich von ganzem Herzen suchen werdet, so will ich mich von euch finden lassen.", "ref": "Jeremia 29:13", "lang": "DE"},
  {"text": "Du sollst den Herrn, deinen Gott, lieben von ganzem Herzen.", "ref": "Matthäus 22:37", "lang": "DE"},
  {"text": "Und das Wort ward Fleisch und wohnte unter uns.", "ref": "Johannes 1:14", "lang": "DE"},
  {"text": "Wer an den Sohn glaubt, der hat das ewige Leben.", "ref": "Johannes 3:36", "lang": "DE"},
  {"text": "Nichts kann uns scheiden von der Liebe Gottes.", "ref": "Römer 8:39", "lang": "DE"},
  {"text": "Gott ist meines Herzens Trost und mein Teil ewiglich.", "ref": "Psalm 73:26", "lang": "DE"},
  {"text": "Eure Güte lasst kund sein allen Menschen! Der Herr ist nahe!", "ref": "Philipper 4:5", "lang": "DE"},
  {"text": "Die Liebe sei ohne Falsch.", "ref": "Römer 12:9", "lang": "DE"},
  {"text": "Der Heilige Geist wird euch zu dieser Stunde lehren, was ihr sagen sollt.", "ref": "Lukas 12:12", "lang": "DE"},
  {"text": "Seid fröhlich in Hoffnung, geduldig in Trübsal, haltet an am Gebet.", "ref": "Römer 12:12", "lang": "DE"},
  {"text": "Denn deine Güte ist besser als Leben.", "ref": "Psalm 63:4", "lang": "DE"},
  {"text": "Seid heilig in allem eurem Wandel.", "ref": "1 Petrus 1:15", "lang": "DE"},
  {"text": "Siehe, ich stehe vor der Tür und klopfe an.", "ref": "Offenbarung 3:20", "lang": "DE"},
  {"text": "Denn das Reich Gottes ist Gerechtigkeit und Friede und Freude im Heiligen Geist.", "ref": "Römer 14:17", "lang": "DE"},
  {"text": "Wo zwei oder drei versammelt sind in meinem Namen, da bin ich mitten unter ihnen.", "ref": "Matthäus 18:20", "lang": "DE"},
  {"text": "Euer himmlischer Vater weiß, dass ihr das alles bedürfet.", "ref": "Matthäus 6:32", "lang": "DE"},
  {"text": "Der Geist des Herrn ist auf mir.", "ref": "Lukas 4:18", "lang": "DE"},
  {"text": "Bei Gott sind alle Dinge möglich.", "ref": "Matthäus 19:26", "lang": "DE"},
  {"text": "Herr, mein Fels, meine Burg, mein Erretter.", "ref": "Psalm 18:3", "lang": "DE"},
  {"text": "Gnade und Wahrheit ist durch Jesus Christus geworden.", "ref": "Johannes 1:17", "lang": "DE"},
  {"text": "Einer trage des anderen Last.", "ref": "Galater 6:2", "lang": "DE"},
  {"text": "Lasst das Wort Christi reichlich unter euch wohnen.", "ref": "Colosser 3:16", "lang": "DE"},
  {"text": "Der Herr ist gerecht in allen seinen Wegen.", "ref": "Psalm 145:17", "lang": "DE"},
  {"text": "Du hast mir Freude in mein Herz gegeben.", "ref": "Psalm 4:8", "lang": "DE"},
  {"text": "Selig sind die Barmherzigen; denn sie werden Barmherzigkeit erlangen.", "ref": "Matthäus 5:7", "lang": "DE"},
  {"text": "Schaffe in mir, Gott, ein reines Herz.", "ref": "Psalm 51:12", "lang": "DE"},
  {"text": "Er heilt, die zerbrochenen Herzens sind.", "ref": "Psalm 147:3", "lang": "DE"},
  {"text": "Lehre mich tun nach deinem Wohlgefallen, denn du bist mein Gott.", "ref": "Psalm 143:10", "lang": "DE"},
  {"text": "Aber du, Herr, bist der Schild für mich und der mich zu Ehren setzt.", "ref": "Psalm 3:4", "lang": "DE"},
  {"text": "Herr, höre meine Stimme, wenn ich rufe.", "ref": "Psalm 27:7", "lang": "DE"},
  {"text": "Du bist mein Gott, und ich danke dir.", "ref": "Psalm 118:28", "lang": "DE"},
  {"text": "Der Herr aber richte eure Herzen zu der Liebe Gottes.", "ref": "2 Thessalonicher 3:5", "lang": "DE"},
  {"text": "Weil du teuer bist in meinen Augen und ich dich lieb habe.", "ref": "Jesaja 43:4", "lang": "DE"},
  {"text": "Der Herr ist mein Schutz, mein Gott ist der Fels meiner Zuversicht.", "ref": "Psalm 94:22", "lang": "DE"},
  {"text": "Sorget euch um nichts.", "ref": "Philipper 4:6", "lang": "DE"},
  {"text": "Der Herr ist unser König; der hilft uns!", "ref": "Jesaja 33:22", "lang": "DE"},
  {"text": "Sättige uns früh mit deiner Gnade.", "ref": "Psalm 90:14", "lang": "DE"},
  {"text": "Selig sind, die da Leid tragen; denn sie sollen getröstet werden.", "ref": "Matthäus 5:4", "lang": "DE"},
  {"text": "Wer mir nachfolgt, wird nicht wandeln in der Finsternis.", "ref": "Johannes 8:12", "lang": "DE"},
  {"text": "Der Herr ist mein Fels und meine Burg.", "ref": "Psalm 144:2", "lang": "DE"},
  {"text": "Gott ist unsere Zuversicht.", "ref": "Psalm 62:9", "lang": "DE"},
  {"text": "Gehe hin mit Frieden.", "ref": "Lukas 7:50", "lang": "DE"},
  {"text": "Die Freude am Herrn ist eure Stärke.", "ref": "Nehemia 8:10", "lang": "DE"},
  {"text": "Der Herr ist der wahrhaftige Gott.", "ref": "Jeremia 10:10", "lang": "DE"},
  {"text": "Der Herr ist gütig.", "ref": "Psalm 100:5", "lang": "DE"},
  {"text": "Liebt Wahrheit und Frieden.", "ref": "Sacharja 8:19", "lang": "DE"},
  {"text": "Betet ohne Unterlass.", "ref": "1 Thessalonicher 5:17", "lang": "DE"},
  {"text": "Vertraue auf Gott.", "ref": "Sprüche 3:5", "lang": "DE"},
  {"text": "Gott ist treu.", "ref": "1 Korinther 1:9", "lang": "DE"},
  {"text": "Der Herr ist dein Hirte.", "ref": "Psalm 23:1", "lang": "DE"},
  {"text": "Der Heilige Geist ist dein Tröster.", "ref": "Johannes 14:26", "lang": "DE"},
  {"text": "Jesus ist der Herr.", "ref": "Römer 10:9", "lang": "DE"},
  {"text": "Liebe Gott.", "ref": "5 Mose 6:5", "lang": "DE"},
  {"text": "Erkenne Gott.", "ref": "1 Johannes 5:20", "lang": "DE"},
  {"text": "Gott schützt uns.", "ref": "2 Thessalonicher 3:3", "lang": "DE"},
  {"text": "Wir haben Hoffnung in Christus.", "ref": "1 Korinther 15:19", "lang": "DE"},
  {"text": "Der Herr ist Licht.", "ref": "Johannes 1:5", "lang": "DE"},
  {"text": "Die Liebe besiegt alles.", "ref": "Römer 12:21", "lang": "DE"},
  {"text": "Gott mit uns.", "ref": "Matthäus 1:23", "lang": "DE"},
  {"text": "Glaube an Christus.", "ref": "Apostelgeschichte 16:31", "lang": "DE"},
  {"text": "Suche den Frieden.", "ref": "Psalm 34:15", "lang": "DE"},
  {"text": "Der Herr wird dir helfen.", "ref": "Jesaja 41:10", "lang": "DE"},
  {"text": "Alles hat seine Zeit.", "ref": "Prediger 3:1", "lang": "DE"},
  {"text": "Gott liebt die Welt.", "ref": "Johannes 3:16", "lang": "DE"},
  {"text": "Der Geist leitet uns.", "ref": "Römer 8:14", "lang": "DE"},
  {"text": "Christus ist auferstanden.", "ref": "Matthäus 28:6", "lang": "DE"},
  {"text": "Seid geduldig.", "ref": "Jakobus 5:7", "lang": "DE"},
  {"text": "Das Gebet hat Kraft.", "ref": "Jakobus 5:16", "lang": "DE"},
  {"text": "Gott ist eine Zuflucht.", "ref": "Psalm 46:2", "lang": "DE"},
  {"text": "Der Herr ist mein Schild.", "ref": "Psalm 28:7", "lang": "DE"},
  {"text": "Die Liebe ist das Größte.", "ref": "1 Korinther 13:13", "lang": "DE"},
  {"text": "Wandelt im Licht.", "ref": "Epheser 5:8", "lang": "DE"},
  {"text": "Gott ist treu in seinen Verheißungen.", "ref": "Hebräer 10:23", "lang": "DE"},
  {"text": "Seid heilig.", "ref": "1 Petrus 1:16", "lang": "DE"},
  {"text": "Der Herr hat dich gerufen.", "ref": "Jesaja 43:1", "lang": "DE"},
  {"text": "Christus ist unser Friede.", "ref": "Epheser 2:14", "lang": "DE"},
  {"text": "Unser tägliches Brot gib uns heute.", "ref": "Matthäus 6:11", "lang": "DE"},
  {"text": "Dein Wort ist Wahrheit.", "ref": "Johannes 17:17", "lang": "DE"},
  {"text": "Vertraue dem Herrn.", "ref": "Psalm 37:3", "lang": "DE"},
  {"text": "Gott ist unser Vater.", "ref": "Matthäus 6:9", "lang": "DE"},
  {"text": "Gott schuf alle Dinge.", "ref": "1 Mose 1:1", "lang": "DE"},
  {"text": "Der Herr ist gütig.", "ref": "Psalm 145:9", "lang": "DE"},
  {"text": "Gott hört deine Stimme.", "ref": "Psalm 116:1", "lang": "DE"},
  {"text": "Wir haben das ewige Leben.", "ref": "1 Johannes 5:13", "lang": "DE"},
  {"text": "Der Herr wird dich stärken.", "ref": "2 Thessalonicher 3:3", "lang": "DE"},
  {"text": "Suche den Frieden.", "ref": "1 Petrus 3:11", "lang": "DE"},
  {"text": "Gott ist mächtig.", "ref": "Lukas 1:37", "lang": "DE"},
  {"text": "Jesus liebt die Kinder.", "ref": "Matthäus 19:14", "lang": "DE"},
  {"text": "Seid stark in dem Herrn.", "ref": "Epheser 6:10", "lang": "DE"},
  {"text": "Die Liebe höret nimmer auf.", "ref": "1 Korinther 13:8", "lang": "DE"},
  {"text": "Der Herr ist dein Heil.", "ref": "2 Mose 15:2", "lang": "DE"},
  {"text": "Gott ist mein König.", "ref": "Psalm 44:5", "lang": "DE"},
  {"text": "Liebt Wahrheit und Frieden.", "ref": "Sacharja 8:19", "lang": "DE"},
  {"text": "Vergebt einander.", "ref": "Epheser 4:32", "lang": "DE"},
  {"text": "Gott ist das Licht des Lebens.", "ref": "Johannes 8:12", "lang": "DE"},
  {"text": "Der Herr ist deine Hilfe.", "ref": "Psalm 121:2", "lang": "DE"},
  {"text": "Die Gnade sei mit euch.", "ref": "2 Korinther 13:13", "lang": "DE"},
  {"text": "Vertrauen bringt Frieden.", "ref": "Jesaja 26:3", "lang": "DE"},
  {"text": "Gott segnet dich.", "ref": "1 Mose 12:2", "lang": "DE"},
  {"text": "Christus ist das Haupt.", "ref": "Colosser 1:18", "lang": "DE"},
  {"text": "Das Reich Gottes ist nahe.", "ref": "Markus 1:15", "lang": "DE"},
  {"text": "Der Herr ist dein Hüter.", "ref": "Psalm 121:5", "lang": "DE"},
  {"text": "Durch Glauben versetzen wir Berge.", "ref": "Matthäus 17:20", "lang": "DE"},
  {"text": "Gott gibt dir Freude.", "ref": "Psalm 16:11", "lang": "DE"},
  {"text": "Jesus ist derselbe gestern und heute.", "ref": "Hebräer 13:8", "lang": "DE"},
  {"text": "Der Herr sieht das Herz an.", "ref": "1 Samuel 16:7", "lang": "DE"},
  {"text": "Friede deinem Hause.", "ref": "Lukas 10:5", "lang": "DE"},
  {"text": "Gott ist der Fels.", "ref": "2 Samuel 22:2", "lang": "DE"},
  {"text": "Der Geist der Wahrheit lehrt uns.", "ref": "Johannes 16:13", "lang": "DE"},
  {"text": "Wir sind Kinder Gottes.", "ref": "Römer 8:16", "lang": "DE"},
  {"text": "Der Herr ist voller Mitleid.", "ref": "Jakobus 5:11", "lang": "DE"},
  {"text": "Gottes Liebe verbindet uns.", "ref": "Colosser 3:14", "lang": "DE"},
  {"text": "Glaube, so wirst du die Herrlichkeit sehen.", "ref": "Johannes 11:40", "lang": "DE"},
  {"text": "Christus in euch, die Hoffnung der Herrlichkeit.", "ref": "Colosser 1:27", "lang": "DE"},
  {"text": "Der Herr wird dir die Tür öffnen.", "ref": "Offenbarung 3:8", "lang": "DE"},
  {"text": "Gott ist deine Zuflucht im Sturm.", "ref": "Jesaja 25:4", "lang": "DE"},
  {"text": "Der Herr ist der wahrhaftige Gott.", "ref": "1 Johannes 5:20", "lang": "DE"},
  {"text": "Die Liebe ist nicht selbstsüchtig.", "ref": "1 Korinther 13:5", "lang": "DE"},
  {"text": "Gott rettet uns.", "ref": "Titus 3:5", "lang": "DE"},
  {"text": "Der Herr ist dein Licht.", "ref": "Psalm 27:1", "lang": "DE"},
  {"text": "Das Wort Gottes ist lebendig.", "ref": "Hebräer 4:12", "lang": "DE"},
  {"text": "Gott gibt dir Frieden.", "ref": "4 Mose 6:26", "lang": "DE"},
  {"text": "Christus ist der Sieger.", "ref": "Offenbarung 17:14", "lang": "DE"},
  {"text": "Der Heilige Geist ist Kraft.", "ref": "Apostelgeschichte 1:8", "lang": "DE"},
  {"text": "Der Herr ist nahe.", "ref": "Philipper 4:5", "lang": "DE"},
  {"text": "Gott ist ein treuer Bundesgenosse.", "ref": "1 Thessalonicher 5:24", "lang": "DE"},
  {"text": "Die Liebe ist das Band der Vollkommenheit.", "ref": "Colosser 3:14", "lang": "DE"},
  {"text": "Der Herr führt mich zu stillen Wassern.", "ref": "Psalm 23:2", "lang": "DE"},
  {"text": "Gottes Wille ist gut.", "ref": "Römer 12:2", "lang": "DE"},
